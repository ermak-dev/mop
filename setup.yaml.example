# Пример окружения папетов — общее всем проектам установки. Скопируйте и
# правьте под себя:
#
#     cp setup.yaml.example setup.yaml
#
# setup.yaml в .gitignore и в git не попадает: он часть установки, как .env и
# inventory.yaml. Ниже стоит окружение той установки, в которой mop писали:
# это образец, а не список обязательного, — выкиньте чужое и впишите своё.
#
# ── Как приспособить под себя ───────────────────────────────────────────────
#
# Держите здесь ровно то, что общее всем вашим проектам: языки и сборочные
# инструменты, личные скиллы claude, свои MCP-серверы. Всё, что нужно одному
# проекту, — в его файл.
#
# Подключается настройкой MOP_BODY_EXTRA: список файлов через запятую, порядок
# значим. Этот идёт первым — на его тулчейн опираются остальные.
#
# Три правила, нарушение которых обходится дорого:
#
#   Задачи, а не игра. У файла два вызывающих, и оба подключают его как
#   список задач: прогон по узлам (deploy/body.yml) и сборка образа шарда
#   (deploy/pve-build.yml). Сделайте плейбук — определение раздвоится, и
#   расходиться половины начнут молча.
#
#   Всё печётся в образ, а не ставится при подъёме папета. Поставьте тяжёлое
#   при подъёме — будет качаться на каждом рестарте каждого папета.
#
#   Файл ждёт become: yes от вызывающего, а всё, что трогает дом пользователя
#   пула, обязано называть его явно (become_user). Умолчания у двух
#   вызывающих разные, и задача без become_user запишет файл в /root,
#   отчитавшись успехом.

- name: Values this installation's body is built from
  ansible.builtin.set_fact:
    nextest_version: 0.9.98


# ЯЩИК ИНСТРУМЕНТОВ: линтеры, клиенты и мелочи, без которых папет
# «проверить и померить» не может. apt ставит то, что в дистро есть;
# shfmt, gh и ruff в apt этого дистро нет — одиночными бинарями с
# приpinенной версией (creates, как у claude CLI: обновление -- правка
# версии здесь).
- name: Ensure the everyday toolbox (apt part)
  ansible.builtin.apt:
    name:
      - shellcheck
      - postgresql-client
      - bc
      - time        # /usr/bin/time: у builtin-версии нет -v
    state: present

- name: Install shfmt (single binary, not in apt)
  ansible.builtin.get_url:
    url: https://github.com/mvdan/sh/releases/download/v3.11.0/shfmt_v3.11.0_linux_amd64
    dest: /usr/local/bin/shfmt
    mode: '0755'

# dest -- /usr/local, а не /usr/local/bin: strip-components=1 превращает
# gh_X/bin/gh в bin/gh, и с dest /usr/local/bin бинарь уезжал в bin/bin
# (поймано живым прогоном на gpu: gh MISSING).
- name: Install gh (single tarball, not in apt)
  ansible.builtin.unarchive:
    src: https://github.com/cli/cli/releases/download/v2.74.0/gh_2.74.0_linux_amd64.tar.gz
    dest: /usr/local
    extra_opts: ["--strip-components=1", "--wildcards", "*/bin/gh"]
    remote_src: yes
    mode: '0755'

- name: Install ruff (single binary, not in apt of this distro)
  ansible.builtin.get_url:
    url: https://github.com/astral-sh/ruff/releases/download/0.9.6/ruff-x86_64-unknown-linux-gnu.tar.gz
    dest: /tmp/ruff.tgz
    mode: '0644'
  register: ruff_tgz

- name: Unpack ruff
  ansible.builtin.shell: tar xzf /tmp/ruff.tgz --strip-components=1 -C /usr/local/bin ruff-x86_64-unknown-linux-gnu/ruff
  when: ruff_tgz is changed

# Тулчейн Rust ставит rustup, а не apt: cargo нужен тот же, каким собирают
# проекты (stable, с rustfmt и clippy), и обновлять его должен сам папет,
# а не релиз дистрибутива. До появления этой задачи cargo на узлах стоял
# с рук -- и свежий узел падал на `cargo install` ниже, потому что бинаря
# просто не было: каталог ~/.cargo/bin ему заводила соседняя задача, и
# отказ читался как «сломался cargo-sweep», а не «нет Rust».
# --no-modify-path: PATH папета задаётся настройкой MOP_PUPPET_PATH, и
# правка ~/.profile до него всё равно не доедет -- врапер не логин-шелл.
- name: Install the Rust toolchain (rustup)
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell: >
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs
    | sh -s -- -y --no-modify-path --profile default
  args:
    creates: "{{ MOP_HOME }}/.cargo/bin/cargo"

- name: Ensure ~/.cargo/bin exists
  ansible.builtin.file:
    path: "{{ MOP_HOME }}/.cargo/bin"
    state: directory
    owner: "{{ MOP_USER }}"
    group: "{{ MOP_USER }}"
    mode: '0755'

- name: Install cargo-nextest {{ nextest_version }}
  ansible.builtin.unarchive:
    src: "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-{{ nextest_version }}/cargo-nextest-{{ nextest_version }}-x86_64-unknown-linux-gnu.tar.gz"
    dest: "{{ MOP_HOME }}/.cargo/bin"
    remote_src: yes
    owner: "{{ MOP_USER }}"
    group: "{{ MOP_USER }}"
    mode: '0755'
    creates: "{{ MOP_HOME }}/.cargo/bin/cargo-nextest"

# cargo-sweep: the size cap pu-sweep (deploy/) applies to a live puppet's
# target dir. The sweep degrades gracefully without it, and the tool itself
# is project toolchain, so it stays here rather than moving to deploy/.
# An age gate cannot stand in for it -- cargo rewrites fingerprints on every
# build, so an actively built target dir never looks old (0 of 34,509 files
# older than 3 days in a 48 GB dir; see ~/bin/cleanup). Built from source
# rather than pinned to a release tarball: cargo-sweep ships no linux-gnu
# binary in its releases, and it compiles in about half a minute.
- name: Install cargo-sweep (size cap for pu-sweep tier 3)
  ansible.builtin.command: "{{ MOP_HOME }}/.cargo/bin/cargo install cargo-sweep --locked"
  become_user: "{{ MOP_USER }}"
  args:
    creates: "{{ MOP_HOME }}/.cargo/bin/cargo-sweep"

# --- cloudpub integration-test environment ---------------------------
# The subset of cloudpub's bin/docker-test that the rust integration
# suite needs: trusted local postgres with a cloudpub superuser role, a
# ru_RU test database, pg_trgm inherited via template1, redis, and
# cloudpub.local resolving to loopback. (rug test needs none of this: it
# provisions its own role and per-run database via `sudo -u postgres`.)


# node for cloudpub's frontend/e2e test sets, per BUILD.md: nvm + 22.12.0 (BUILD.md says 22.11.0, but server/Dockerfile pins
# NODE_VERSION=22.12.0 and vite refuses anything older).
# Per-user install under the pool user -- the same account the puppets run as.
# pipefail и проверка результата — по тому же доводу, что у установщика claude
# в deploy/body-tasks.yml: код конвейера `curl | bash` это код bash, и
# оборванная загрузка проходит как успех. Без node тело собирается «зелёным», а
# первый же `npx` в нём не находит ничего.
- name: Install nvm
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell: |
    set -o pipefail
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash
    test -s "{{ MOP_HOME }}/.nvm/nvm.sh"
  args:
    creates: "{{ MOP_HOME }}/.nvm/nvm.sh"
    executable: /bin/bash

- name: Install node 22.12.0
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell: . ~/.nvm/nvm.sh && nvm install 22.12.0 && nvm alias default 22.12.0
  args:
    creates: "{{ MOP_HOME }}/.nvm/versions/node/v22.12.0"
    executable: /bin/bash

- name: Install yarn
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell: . ~/.nvm/nvm.sh && npm install -g yarn
  args:
    creates: "{{ MOP_HOME }}/.nvm/versions/node/v22.12.0/bin/yarn"
    executable: /bin/bash



# ── скиллы и MCP-серверы установки ───────────────────────────────────────
# Пишутся в ~/.claude и ~/.claude.json, то есть туда, где живёт сессия папета,
# — поэтому это тело, а не узел. Идут после тулчейна: регистрация сервера зовёт
# claude, а он ищется в PATH, который ставит nvm.
#
# Каждая задача ниже, трогающая дом пользователя пула, называет его явно
# (`become_user`), а не полагается на умолчание игры. Пока здесь стояло
# умолчание, `claude mcp add` в сборке образа записал все три сервера в
# /root/.claude.json: задачи зелёные, образ собран, а папет в теле остался с
# одним лишь своим сервером.

- name: Values the desktop MCP servers are registered with
  ansible.builtin.set_fact:
    # Читаем .env проекта как properties: секции в нём нет, а type=properties
    # ровно про файлы вида KEY=value.
    windows_mcp_token: "{{ lookup('ini', 'WINDOWS_MCP_TOKEN type=properties file=' + lookup('env', 'HOME') + '/mop/.env') }}"
    mac_mcp_token: "{{ lookup('ini', 'MAC_MCP_TOKEN type=properties file=' + lookup('env', 'HOME') + '/mop/.env') }}"
    skills_tgz: "/tmp/mop-skills.tgz"
  no_log: true

# Узел, живущий внутри windows-хоста, достаёт до него только по loopback:
# там mirrored networking, и Windows-файрвол роняет хайрпин на LAN-адрес.
#
# Критерий тот же, что у врапера папета: адрес windows-хоста среди адресов
# собственных интерфейсов узла.
- name: Own IPv4 addresses of this node
  ansible.builtin.command: ip -4 -o addr show
  register: node_addrs
  changed_when: false

- name: URL of windows-mcp as seen from this node
  ansible.builtin.set_fact:
    windows_mcp_url: >-
      {{ 'http://127.0.0.1:' ~ MCP_PORT ~ '/mcp'
         if WINDOWS_MCP_HOST and WINDOWS_MCP_HOST in node_addrs.stdout
         else 'http://' ~ WINDOWS_MCP_HOST ~ ':' ~ MCP_PORT ~ '/mcp' }}

- name: Ensure ~/.claude exists
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.file:
    # Абсолютный путь: по ssh относительный попадает в дом узла, но на
    # машине с local connection (управляющая в роли узла пула) -- в каталог
    # плейбука, и следующий же синк высыпал бы скиллы прямо в репозиторий.
    path: "{{ MOP_HOME }}/.claude"
    state: directory
    mode: "0755"

# tar -h вместо copy_links: скилл master лежит в репозитории (skills/master) и
# виден на управляющей машине симлинком из ~/.claude/skills. Без разыменования
# в тело уехал бы сам симлинк и висел бы там в пустоту.
#
# Архивом, а не synchronize: тот строит свой ssh сам и теряет при этом
# ansible_ssh_common_args, то есть ProxyJump, -- и честно идёт в сеть тел с
# управляющей машины, которой туда хода нет. Ровно на этом сборка образа уже
# спотыкалась на пакете mop.
#
# Пропуск на управляющей машине не лень: она и есть источник этого синка, а
# разыменование её симлинка скилла мастера заменило бы его настоящей копией -- и
# правки скилла перестали бы попадать в историю репозитория.
- name: Pack the skills up
  ansible.builtin.command:
    cmd: tar czhf {{ skills_tgz }} -C {{ lookup('env', 'HOME') }}/.claude/skills .
  delegate_to: localhost
  become: no
  changed_when: true
  when: "'master' not in group_names"

# Снести и разложить заново -- это `delete: yes`, которым synchronize выметал
# снятые скиллы. Без сноса удалённый скилл лежал бы в теле вечно, а это хуже
# миллисекундной дыры внутри прогона deploy, который и так перезапускает агента.
- name: Old skills go before the new ones
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.file:
    path: "{{ MOP_HOME }}/.claude/skills"
    state: "{{ item }}"
    mode: "0755"
  loop: [absent, directory]
  when: "'master' not in group_names"

- name: Sync ~/.claude/skills from the control machine
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.unarchive:
    src: "{{ skills_tgz }}"
    dest: "{{ MOP_HOME }}/.claude/skills/"
  when: "'master' not in group_names"

# Сначала снять, потом поставить: add на существующей записи ошибается,
# а сравнить желаемое с фактом CLI не умеет -- токены он прячет даже от
# get. exec -- чтобы код возврата задачи был кодом add, а не remove.
# claude на узле живёт в nvm, которого нет в PATH неинтерактивного ssh:
# MOP_PUPPET_PATH -- уже готовый PATH папета, им же и ищем.
# Chromium в образ, а не при подъёме папета. Врапер и так делает
# `npx -y playwright install chromium` на каждой загрузке, но это установка на
# 2 ГБ по сети: в теле, где её не сделали заранее, она идёт при первом подъёме
# каждого нового папета, а кончается строка на `|| true` -- то есть провал
# ничего не скажет. Здесь она разовая, и врапер после неё лишь подтверждает
# наличие.
- name: Warm up chromium for playwright
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell: npx -y playwright install chromium
  args:
    creates: "{{ MOP_HOME }}/.cache/ms-playwright"
  environment:
    PATH: "{{ MOP_PUPPET_PATH | replace('{HOME}', MOP_HOME) }}"

- name: Register playwright MCP
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell:
    cmd: |
      claude mcp remove -s user playwright >/dev/null 2>&1 || true
      exec claude mcp add -s user playwright -- npx -y '@playwright/mcp@latest' --headless --isolated --browser chromium
  environment:
    PATH: "{{ MOP_PUPPET_PATH | replace('{HOME}', MOP_HOME) }}"
  changed_when: false

- name: Register windows-mcp
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell:
    cmd: |
      claude mcp remove -s user windows-mcp >/dev/null 2>&1 || true
      exec claude mcp add -s user --transport http windows-mcp '{{ windows_mcp_url }}' --header 'Authorization: Bearer {{ windows_mcp_token }}'
  environment:
    PATH: "{{ MOP_PUPPET_PATH | replace('{HOME}', MOP_HOME) }}"
  changed_when: false
  no_log: true

- name: Register mac-mcp
  become: yes
  become_user: "{{ MOP_USER }}"
  ansible.builtin.shell:
    cmd: |
      claude mcp remove -s user mac-mcp >/dev/null 2>&1 || true
      exec claude mcp add -s user --transport http mac-mcp 'http://{{ MAC_MCP_HOST }}:{{ MCP_PORT }}/mcp' --header 'Authorization: Bearer {{ mac_mcp_token }}'
  environment:
    PATH: "{{ MOP_PUPPET_PATH | replace('{HOME}', MOP_HOME) }}"
  changed_when: false
  no_log: true
