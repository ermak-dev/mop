# Disk watchdog on every pool node: sysbatch puts one instance on each eligible
# client, periodic runs it by cron. New nodes join the schedule the moment they
# join the cluster. The script itself is distributed by ansible (nomad/setup.yml)
# to /usr/local/bin/sl-sweep.
#
# Hourly, not nightly. It was nightly until 2026-08-28, when gamer filled its
# Windows C: drive between two runs, WSL stopped booting
# (Wsl/Service/CreateInstance/E_FAIL) and the node sat out of the cluster for
# two days. The sweep is cheap when there is no pressure -- tier 3, the only
# expensive tier, is gated on free space -- so the cost of running it 24x more
# often is a few stats per node.
#
# That outage also wedged the schedule, which is worth knowing about: a sysbatch
# child stays `pending` until it can place on EVERY eligible node, and
# prohibit_overlap then blocks each following run. One unreachable node stopped
# mirror being swept too. Placement headroom is therefore part of the design --
# see nomad_reserved_mb in setup.yml.
job "sl-cleanup" {
  datacenters = ["{{ MOP_POOL_DC }}"]
  type        = "sysbatch"

  periodic {
    crons            = ["0 * * * *"]
    time_zone        = "Asia/Novosibirsk"
    prohibit_overlap = true
  }

  group "cleanup" {
    task "sweep" {
      driver = "raw_exec"
      user   = "{{ MOP_USER }}"

      config {
        command = "/usr/local/bin/sl-sweep"
      }

      env {
        HOME = "{{ MOP_HOME }}"

        # Escalate to capping live workers' target dirs below this much free on
        # the tightest watched filesystem. 60 GB is roughly a day of headroom at
        # the rate three rugent workers grow a target dir, which is more than
        # the one hour until the next run.
        WK_SWEEP_FREE_MIN_GB = "60"

        # Per-target-dir cap handed to `cargo sweep --maxsize`, same value
        # ~/bin/cleanup uses on the CI runners.
        WK_SWEEP_MAX_TARGET = "15GB"

        # Age gate for retired paths. Two weeks: long enough that a path which
        # is merely between builds is never mistaken for an abandoned one.
        WK_SWEEP_STALE_DAYS = "14"
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }
  }
}
