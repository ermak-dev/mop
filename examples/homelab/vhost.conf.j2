server {
    listen 443 ssl;
    server_name {{ MOP_TLS_HOST }};
    ssl_certificate /etc/letsencrypt/live/{{ MOP_TLS_HOST }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ MOP_TLS_HOST }}/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:4646;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # log streaming holds the connection open; the API pings well under this
        proxy_read_timeout 310s;
        proxy_buffering off;
    }
}
