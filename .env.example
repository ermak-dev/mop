# Пример .env установки mop. Скопируйте и заполните:
#
#     cp .env.example .env
#
# Здесь всё, что задаёт человек. Порождаемое само сюда не пишется и не
# попадает: пароли NATS заводит плейбук в ~/.config/mop/secrets/, токен
# Nomad приезжает из его бутстрапа, логин claude.ai кладёт `claude login`.
#
# Сам файл на узлы не едет никогда: на узел уезжает только поименованный
# срез -- ключи LLM-профилей (их собирает `mop login` в secrets.env).
#
# Полный словарь настроек с дефолтами: `mop config`. Разработка самого mop
# (команда `mop bug`) требует ещё GITLAB_TOKEN -- установке он не нужен,
# поэтому его здесь нет.

# ── Обязательные: без них mop откажется работать ────────────────────────
# Адрес сервера в LAN: узлы ходят на него (Nomad RPC, шина), и мастер тоже.
MOP_SERVER_LAN=192.168.1.10
# Откуда папеты клонируют проекты: узел доверяет ключ именно этого хоста.
MOP_GIT_HOST=git.example.com

# ── Ключи LLM-провайдеров ───────────────────────────────────────────────
# Имя переменной называет профиль в mop/llm/ (один файл = один профиль);
# заполните ключи тех профилей, что используете. На узлы уезжают только
# они, остальное отсюда пул не видит. Каким профилем подниматься по
# умолчанию -- MOP_DEFAULT_LLM ниже.
Z_AI_KEY=
ANTHROPIC_API_KEY=

# ── Опциональные: пусто = функциональности нет ──────────────────────────
# Токены MCP-серверов автоматизации рабочего стола (см. mop/config.py,
# OPTIONAL): в спеке джоба им место запрещено, здесь -- можно.
WINDOWS_MCP_TOKEN=
MAC_MCP_TOKEN=

# ── Часто меняемое; у всего остального дефолт верен почти всегда ────────
# Дефолтный профиль папетов (имя файла из mop/llm/).
MOP_DEFAULT_LLM=zai
# Общий файл окружения папетов: путь от корня репозитория, порядок значим
# (скиллы и MCP -- после тулчейна: регистрация зовёт claude из PATH nvm).
# setup.yaml -- ваша копия setup.yaml.example, в git он не попадает;
# свой тулчейн правьте в ней. Пусто -- папет получает только обязательное.
MOP_BODY_EXTRA=setup.yaml
# Пользователь и дом на узлах пула (дефолт -- текущий пользователь мастера).
# MOP_HOME=/home/pool
# MOP_USER=pool

# Если releases.hashicorp.com недоступен из вашей сети -- зеркало Nomad:
# MOP_NOMAD_MIRROR=https://hashicorp.releases.yandexcloud.net
