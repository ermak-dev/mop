# Настройки и секреты установки. Скопируйте в .env и заполните:
#
#     cp .env.example .env && chmod 600 .env
#
# .env в .gitignore, на узлы пула не уезжает и в git не попадает. Что действует
# сейчас и откуда взялось — покажет `mop config`.

# ─── ОБЯЗАТЕЛЬНО ─────────────────────────────────────────────────────────
# Без этого mop не работает: осмысленного значения по умолчанию у них нет.

# Адрес сервера в ЛОКАЛЬНОЙ сети: туда узлы дозваниваются за RPC Nomad (4647)
# и за шиной (4222). Публичное имя тут не годится: оно резолвится в адрес
# роутера, а хайрпина на эти порты роутер не делает.
MOP_SERVER_LAN=192.168.0.10

# Всё остальное про кластер считается отсюда. NOMAD_ADDR, например, — это
# http://MOP_SERVER_LAN:MOP_NOMAD_PORT; вписывать его нужно, только если API
# Nomad стоит не там (чужой кластер, другой порт, прокси перед ним).

# ─── СЕКРЕТЫ ─────────────────────────────────────────────────────────────
# Порождаемого само тут нет и быть не должно: пароли NATS заводит плейбук в
# ~/.config/mop/secrets/, токен Nomad приезжает из его бутстрапа, логин
# claude.ai кладёт `claude login`.

# Ключи LLM-провайдеров. Имя переменной называет её профиль-плагин в mop/llm/
# (один файл = один профиль); на узлы уезжают ТОЛЬКО названные профилями.
#Z_AI_KEY=

# Трекер задач, если мастер с ним работает.
#GITLAB_SITE=
#GITLAB_USER=
#GITLAB_PASSWORD=

# ─── НЕОБЯЗАТЕЛЬНО ───────────────────────────────────────────────────────
# Пусто = такой функциональности нет.

# MCP автоматизации рабочего стола: без них папеты просто не увидят серверов.
#WINDOWS_MCP_HOST=192.168.0.20
#WINDOWS_MCP_TOKEN=
#MAC_MCP_HOST=192.168.0.30
#MAC_MCP_TOKEN=
#MCP_PORT=8000

# Память узла, отрезанная под чужих жильцов хоста: узел=МБ.
#MOP_RESERVED_MB=media=2048

# ─── С ДЕФОЛТАМИ ─────────────────────────────────────────────────────────
# Переопределяют редко; значения ниже — то, что действует без .env.
#MOP_HOME=/home/you
#MOP_USER=you
#MOP_POOL_DC=home
#MOP_CONTROL_DC=control
#MOP_PUPPET_MEM_MB=8192
# PATH папета на узлах: {HOME} подставляется на месте, а версия node в nvm —
# свойство установки узлов.
#MOP_PUPPET_PATH=/usr/local/bin:/usr/bin:/bin:{HOME}/.local/bin:{HOME}/.cargo/bin:{HOME}/.nvm/versions/node/v22.12.0/bin
#MOP_FALLBACK_MODEL=opus
# Каким профилем (mop/llm/) поднимать сессию без явного --llm: папета или
# мастера.
#MOP_DEFAULT_LLM=claude
# Что врапер сеет в клон из ~/puppet-env/<проект> и что wipe щадит при
# git clean -x (запятая, gitignore-шаблоны).
#MOP_PUPPET_SEED=.env*,.providers
#MOP_NATS_PORT=4222
#MOP_NOMAD_PORT=4646
#MOP_NOMAD_RPC_PORT=4647
#MOP_NOMAD_VERSION=1.10.5
# Зеркало релизов HashiCorp, если официальный хост из вашей страны не открыт.
#MOP_NOMAD_MIRROR=https://releases.hashicorp.com
#MOP_NATS_VERSION=2.14.6

# ─── СТОРОЖ ДИСКА И СБОРКА МУСОРА ─────────────────────────────────────────
# Мягкий порог (сторож на узле режет target-каталоги) и жёсткий (mop gc
# пересоздаёт свободных папетов). Второй обязан быть заметно ниже первого.
#MOP_SWEEP_FREE_MIN_GB=60
#MOP_SWEEP_MAX_TARGET=15GB
#MOP_SWEEP_STALE_DAYS=14
#MOP_GC_FREE_MIN_GB=25
#MOP_GC_MAX_PER_RUN=1
