# Пример .env установки mop. Скопируйте и заполните:
#
#     cp .env.example .env
#
# Здесь всё, что задаёт человек. Порождаемое само сюда не пишется и не
# попадает: пароли NATS заводит плейбук в ~/.config/mop/secrets/, токен
# Nomad приезжает из его бутстрапа, логин claude.ai кладёт `claude login`.
#
# Сам файл на узлы не едет никогда: на узел уезжает только поименованный
# срез -- ключи LLM-профилей (их собирает `mop login` в secrets.env).
#
# Полный словарь настроек с дефолтами: `mop server config`. Разработка самого mop
# (команда `mop bug`) требует ещё GITLAB_TOKEN -- установке он не нужен,
# поэтому его здесь нет.

# ── Обязательные: без них mop откажется работать ────────────────────────
# Адрес сервера в LAN: узлы ходят на него (Nomad RPC, шина), и мастер тоже.
MOP_SERVER_LAN=192.168.1.10
# Откуда папеты клонируют проекты: узел доверяет ключ именно этого хоста.
MOP_GIT_HOST=git.example.com
# Приватный ключ, под которым узлы и тела клонируют проекты. Его публичная
# часть должна быть зарегистрирована на MOP_GIT_HOST с правом чтения всех
# проектов пула. Дефолт -- первый существующий из ~/.ssh/id_ed25519,
# ~/.ssh/id_rsa на машине, откуда идёт mop server deploy; впишите, если ключ иной.
# MOP_GIT_KEY=/home/mop/.ssh/mop-pool

# ── Машины установки ────────────────────────────────────────────────────
# Локаль, которую прогон генерирует и делает системной на всех машинах пула.
# По умолчанию C.UTF-8: она встроена в glibc и есть везде. UTF-8 обязателен —
# без него не стартует сам ansible.
# MOP_LOCALE=ru_RU.UTF-8
# Замер времени задач ansible: непустое значение включает. Нужен при разборе
# «что дорого в раскатке»; в обычных прогонах только удлиняет хвост.
# MOP_ANSIBLE_PROFILE=1

# ── Люди ────────────────────────────────────────────────────────────────
# Кто работает с пулом, решает провайдер личностей (#205, #219): файл
# операторов на контроллере (`mop server user add|delete|passwd` на сервере) или
# каталог организации (LDAP, #208). На шину людей пускает auth callout
# (#206). Роли: admin -- весь пул плюс машины (disk, узлы); user с проектами
# -- только они; user:* -- все проекты, но не машины. Входят `mop join
# <логин>`. Прежний MOP_OPERATORS ушёл: deploy отказывает, пока он здесь, --
# людей переносит `mop server user import`.
# MOP_OPERATORS_FILE=                 # пусто -- ~/.config/mop/secrets/operators

# Люди из каталога организации (#208) вместо файла операторов.
# MOP_AUTH_PROVIDER=ldap
# MOP_LDAP_URL=ldaps://ldap.example.com
# MOP_LDAP_BIND_DN=cn=mop,ou=services,dc=example,dc=com
# MOP_LDAP_BIND_PASSWORD=
# MOP_LDAP_BASE=ou=people,dc=example,dc=com
# MOP_LDAP_GROUP_BASE=ou=groups,dc=example,dc=com
# MOP_LDAP_ADMIN_GROUP=cn=mop-admins,ou=groups,dc=example,dc=com
# MOP_LDAP_PROJECT_GROUP=mop-{project}
# AD: MOP_LDAP_LOGIN_ATTR=sAMAccountName; ldap:// -- только с MOP_LDAP_STARTTLS=yes
#
# Active Directory с одной группой доступа и вложенными группами (#220):
# MOP_LDAP_URL=ldaps://dc.corp.example.com
# MOP_LDAP_CA_FILE=/etc/ssl/certs/corp-root-ca.pem
# MOP_LDAP_LOGIN_ATTR=sAMAccountName
# MOP_LDAP_ACCESS_GROUP=CN=Pool Users,OU=Access,DC=corp,DC=example,DC=com
# MOP_LDAP_ADMIN_GROUP=CN=Pool Admins,OU=Access,DC=corp,DC=example,DC=com
# MOP_LDAP_NESTED=ad

# Сертификат TLS-прокси сервера (#96): дашборд в корне, шина по WebSocket на
# /nats. Пути к PEM на контроллере; имя в сертификате обязано совпадать с
# MOP_SERVER_LAN. Не заданы -- deploy один раз заводит самоподписанный и
# клиенты закрепляют его; при продлении хватит заменить файлы и прогнать deploy.
# MOP_TLS_CERT=/etc/letsencrypt/live/mop.example.com/fullchain.pem
# MOP_TLS_KEY=/etc/letsencrypt/live/mop.example.com/privkey.pem
# MOP_HTTPS_PORT=443

# LLM-прокси сервера (#379): все профили LLM за одним /v1/messages, пул
# аккаунтов внутри; панель управления -- на /llm/ того же TLS-прокси.
# Ключи клиентский и management генерирует deploy в secrets/ контроллера.
# MOP_LLM_PROXY_VERSION=8.0.8
# MOP_LLM_PROXY_PORT=8317

# Катить только зелёное (#231): `mop server deploy` отказывает, пока пайплайн GitLab
# для HEAD рабочей копии не success. Нужен CI в репозитории и GITLAB_TOKEN
# (или GITLAB_USER и GITLAB_PASSWORD) здесь же. Аварийный обход --
# `mop server deploy --skip-pipeline`.
# MOP_DEPLOY_NEEDS_GREEN=1

# ── Ключи LLM-провайдеров ───────────────────────────────────────────────
# Имя переменной называет профиль в mop/common/llm/ (один файл = один профиль);
# заполните ключи тех профилей, что используете. На узлы уезжают только
# они, остальное отсюда пул не видит. Каким профилем подниматься по
# умолчанию -- MOP_DEFAULT_LLM ниже.
Z_AI_KEY=
ANTHROPIC_API_KEY=

# ── Опциональные: пусто = функциональности нет ──────────────────────────
# Токены MCP-серверов автоматизации рабочего стола (см. mop/common/config.py,
# OPTIONAL): в спеке джоба им место запрещено, здесь -- можно.
WINDOWS_MCP_TOKEN=
MAC_MCP_TOKEN=

# ── Часто меняемое; у всего остального дефолт верен почти всегда ────────
# Дефолтный профиль папетов (имя файла из mop/common/llm/).
MOP_DEFAULT_LLM=zai
# Общий файл окружения папетов: путь от корня репозитория, порядок значим
# (скиллы и MCP -- после тулчейна: регистрация зовёт claude из PATH nvm).
# sandbox.yaml -- ваша копия sandbox.yaml.example, в git он не попадает;
# свой тулчейн правьте в ней. Пусто -- папет получает только обязательное.
MOP_BODY_EXTRA=sandbox.yaml
# Пользователь и дом на узлах пула (дефолт -- текущий пользователь мастера).
# MOP_HOME=/home/pool
# MOP_USER=pool

# Откуда качать Nomad. Дефолт -- зеркало mirror.yandex.ru; если из вашей
# сети отвечает официальный адрес, его можно вернуть:
# MOP_NOMAD_MIRROR=https://releases.hashicorp.com
