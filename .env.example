# Настройки и секреты установки. Скопируйте в .env и заполните:
#
#     cp .env.example .env && chmod 600 .env
#
# .env в .gitignore, на узлы пула не уезжает и в git не попадает. Что действует
# сейчас и откуда взялось — покажет `mop config`.

# ─── ОБЯЗАТЕЛЬНО ─────────────────────────────────────────────────────────
# Без этого mop не работает: осмысленного значения по умолчанию у них нет.

# API вашего кластера Nomad.
NOMAD_ADDR=https://nomad.example.com
# Адрес сервера в ЛОКАЛЬНОЙ сети: туда узлы дозваниваются за RPC Nomad (4647)
# и за шиной. Отдельно от NOMAD_ADDR потому, что публичное имя часто
# резолвится в адрес роутера, а хайрпина на нужные порты роутер не делает.
MOP_SERVER_LAN=192.168.1.10
# Имя, на которое выписан сертификат шины. Клиенты ходят на MOP_SERVER_LAN, а
# проверяют сертификат по этому имени.
MOP_TLS_HOST=nomad.example.com

# ─── СЕКРЕТЫ ─────────────────────────────────────────────────────────────
# Порождаемого само тут нет и быть не должно: пароли NATS заводит плейбук в
# ~/.config/mop/secrets/, токен Nomad приезжает из его бутстрапа, логин
# claude.ai кладёт `claude login`.

# Ключи LLM-провайдеров. Имя переменной называет профиль в LLM_PROFILES
# (mop/slaves.py); на узлы уезжают ТОЛЬКО названные профилями.
#Z_AI_KEY=

# Трекер задач, если мастер с ним работает.
#GITLAB_SITE=
#GITLAB_USER=
#GITLAB_PASSWORD=

# ─── НЕОБЯЗАТЕЛЬНО ───────────────────────────────────────────────────────
# Пусто = такой функциональности нет.

# MCP автоматизации рабочего стола: без них слейвы просто не увидят серверов.
#WINDOWS_MCP_HOST=192.168.1.20
#WINDOWS_MCP_FQDN=windows.example.com
#WINDOWS_MCP_TOKEN=
#MAC_MCP_HOST=mac
#MAC_MCP_TOKEN=
#MCP_PORT=8000

# Имя узла в Nomad = ssh-алиас, через запятую. Нужен только `mop attach`.
#MOP_SSH_ALIAS=gamer=gamer-wsl
# Память узла, отрезанная под чужих жильцов хоста: узел=МБ.
#MOP_RESERVED_MB=mirror=33602
# Webroot certbot, если сертификат шине выписывает плейбук.
#MOP_ACME_WEBROOT=/home/you/example.com

# ─── С ДЕФОЛТАМИ ─────────────────────────────────────────────────────────
# Переопределяют редко; значения ниже — то, что действует без .env.
#MOP_HOME=/home/you
#MOP_USER=you
#MOP_POOL_DC=home
#MOP_CONTROL_DC=control
#MOP_SLAVE_MEM_MB=8192
#MOP_FALLBACK_MODEL=opus
#MOP_NATS_PORT=4222
#MOP_NOMAD_VERSION=1.10.5
# Зеркало релизов HashiCorp, если официальный хост из вашей страны не открыт.
#MOP_NOMAD_MIRROR=https://releases.hashicorp.com
#MOP_NATS_VERSION=2.14.6
