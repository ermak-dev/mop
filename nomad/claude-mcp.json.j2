{
  "mop": {
    "type": "stdio",
    "command": "/home/ermak/mop/bin/mop",
    "args": ["mcp"]
  },
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest",
      "--headless",
      "--isolated",
      "--browser",
      "chromium"
    ]
  },
  "windows-mcp": {
    "type": "http",
    "url": "{{ windows_mcp_url }}",
    "headers": {
      "Authorization": "Bearer {{ windows_mcp_token }}"
    }
  },
  "mac-mcp": {
    "type": "http",
    "url": "http://mac:8000/mcp",
    "headers": {
      "Authorization": "Bearer {{ mac_mcp_token }}"
    }
  }
}
