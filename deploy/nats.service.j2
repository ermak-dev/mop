[Unit]
Description=NATS server (шина пула mop)
After=network-online.target
Wants=network-online.target

[Service]
# Под root ради /etc/nats/nats-server.conf: внутри пароли всех шардов, и файл
# читается только root'ом. (Раньше причиной был ключ letsencrypt; TLS снят,
# причина осталась другая.)
ExecStart=/usr/local/bin/nats-server -c /etc/nats/nats-server.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
