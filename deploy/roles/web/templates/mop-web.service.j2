[Unit]
Description=mop-web (дашборд пула: состояние по HTTP)
After=network-online.target nats.service
Wants=network-online.target

[Service]
User={{ MOP_USER }}
WorkingDirectory={{ MOP_HOME }}/mop
# .env на сервер не едет, а адрес сервера обязателен: без него config
# отказывается работать (и правильно). Окружение старше .env, поэтому
# юнит и есть источник этой настройки на сервере.
Environment=MOP_SERVER_LAN={{ MOP_SERVER_LAN }}
Environment=MOP_NATS_PORT={{ MOP_NATS_PORT }}
# Каталог сервера ходит на шину через TLS-прокси (#97).
Environment=MOP_HTTPS_PORT={{ MOP_HTTPS_PORT }}
Environment=MOP_NOMAD_PORT={{ MOP_NOMAD_PORT }}
Environment=MOP_POOL_DC={{ MOP_POOL_DC }}
Environment=PYTHONUNBUFFERED=1
# Через диспетчер: он ставит PYTHONPATH, без него командлет пакета не найдёт.
ExecStart={{ MOP_HOME }}/mop/bin/mop web --port {{ MOP_WEB_PORT }} --bind {{ MOP_WEB_BIND }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
