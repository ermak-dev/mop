[Unit]
Description=mop-bootstrap (bootstrap песочниц: играет .mop/bootstrap.yaml проекта при каждом старте папета)
After=network-online.target nats.service
Wants=network-online.target

[Service]
User={{ MOP_USER }}
WorkingDirectory={{ MOP_HOME }}/mop
# .env на сервер не едет: всё, что подписчику и прогону нужно знать об
# установке, приезжает юнитом. MOP_HOME и MOP_USER -- те, что у узлов: их
# читают задачи bootstrap'а как переменные прогона, и дефолт сервера
# (его собственный дом) здесь был бы неправдой.
Environment=MOP_SERVER_LAN={{ MOP_SERVER_LAN }}
Environment=MOP_NATS_PORT={{ MOP_NATS_PORT }}
# Каталог сервера ходит на шину через TLS-прокси (#97).
Environment=MOP_HTTPS_PORT={{ MOP_HTTPS_PORT }}
Environment=MOP_HOME={{ MOP_HOME }}
Environment=MOP_USER={{ MOP_USER }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ MOP_HOME }}/mop/bin/mop bootstrap serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
