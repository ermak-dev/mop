[Unit]
Description=mop-cluster (сервис кластера: Nomad за шиной, глаголы пула на mop.*.cluster.rpc)
After=network-online.target nats.service nomad.service
Wants=network-online.target

[Service]
User={{ MOP_USER }}
WorkingDirectory={{ MOP_HOME }}/mop
# .env на сервер не едет: что сервису нужно знать об установке, приезжает
# юнитом. MOP_SERVER_LAN отвечает сразу за адрес шины и за NOMAD_ADDR
# (config.DERIVED), поэтому второй переменной для Nomad здесь нет.
Environment=MOP_SERVER_LAN={{ MOP_SERVER_LAN }}
Environment=MOP_NATS_PORT={{ MOP_NATS_PORT }}
Environment=MOP_HOME={{ MOP_HOME }}
Environment=MOP_USER={{ MOP_USER }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ MOP_HOME }}/mop/bin/mop cluster serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
