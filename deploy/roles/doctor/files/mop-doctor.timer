# doctor по расписанию (#359): вместо nomad periodic pu-cleanup, тем же ритмом.
[Unit]
Description=mop-doctor по расписанию: ежечасно

[Timer]
# Ежечасно, как pu-cleanup: давление на диск набирается между прогонами за
# часы, а не сутки (узел, выпавший 28.08, заполнился между двумя ночными).
OnCalendar=hourly
# Пропущенное за простоем не догоняется: прогон на загрузке встретил бы пул,
# который ещё поднимается, -- молчащих агентов и папетов без сессий, -- а
# следующий час наступит и так.
Persistent=false
Unit=mop-doctor.service

[Install]
WantedBy=timers.target
