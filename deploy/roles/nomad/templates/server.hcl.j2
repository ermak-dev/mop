# Сервер Nomad. RPC и serf -- на всех интерфейсах: туда дозваниваются
# клиенты. HTTP API -- на MOP_NOMAD_HTTP_BIND, по умолчанию тоже на всех.
#
# HTTP API стоял на loopback, а наружу его отдавал nginx ради TLS. Прокси
# снят: между сервером и теми, кто ходит в API, теперь открытый текст, и это
# осознанно: слоем ниже RPC 4647 не шифрован и не аутентифицирован сегодня,
# так что TLS над ним защищал бы дверь рядом с проломленной стеной.
#
# Из процессов в API теперь ходит ровно один -- mop-cluster, и он на этой же
# машине (#80, #81): токен Nomad с машин операторов ушёл (#82). Поэтому
# установка вправе поставить MOP_NOMAD_HTTP_BIND в 127.0.0.1 и закрыть API
# для LAN совсем. Дефолт этого не делает намеренно: по тому же адресу
# открывают веб-интерфейс Nomad, и решать, нужен ли он, -- дело установки, а
# не тихой смены поведения при обновлении.
#
# Что держит это честным -- роутер, а не конфиг: наружу проброшены только 443
# и 22. Ставя mop в сети, где это не так, начинать надо отсюда: management-API
# Nomad в интернете закрыт одним лишь ACL.
datacenter = "{{ MOP_POOL_DC }}"
data_dir   = "{{ MOP_NOMAD_DATA }}"
bind_addr  = "0.0.0.0"

# Проверка обновлений у вендора выключена: это единственное, чем кластер сам
# ходил в интернет. При каждом старте и дальше раз в сутки Nomad стучится на
# checkpoint-api.hashicorp.com -- в логах узла это видно как
# `Failed to check for updates`. Пулу оно бесполезно вдвойне: версия задана
# настройкой MOP_NOMAD_VERSION и ставится плейбуком, так что поступить с
# ответом кластеру всё равно нечего.
disable_update_check = true

ports {
  http = {{ MOP_NOMAD_PORT }}
  rpc  = {{ MOP_NOMAD_RPC_PORT }}
}

addresses {
  http = "{{ MOP_NOMAD_HTTP_BIND }}"
}

advertise {
  http = "{{ MOP_SERVER_LAN }}"
  rpc  = "{{ MOP_SERVER_LAN }}"
  serf = "{{ MOP_SERVER_LAN }}"
}

server {
  enabled          = true
  bootstrap_expect = 1
}

acl {
  enabled = true
}

ui {
  enabled = true
}
