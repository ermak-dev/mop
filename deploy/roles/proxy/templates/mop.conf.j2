# TLS-прокси mop (#96). Разворачивает deploy/roles/proxy, описан в docs/WEB.md
# и docs/BUS.md.

map $http_upgrade $mop_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ MOP_HTTPS_PORT }} ssl;
    listen [::]:{{ MOP_HTTPS_PORT }} ssl;
    server_name {{ MOP_SERVER_LAN }};

    ssl_certificate     /etc/nginx/mop/tls.pem;
    ssl_certificate_key /etc/nginx/mop/tls.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Шина. Таймауты в час: NATS пингует раз в две минуты, и дефолтные
    # 60 секунд рвали бы молчащее соединение мастера.
    location = /nats {
        proxy_pass http://127.0.0.1:{{ MOP_NATS_WS_PORT }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mop_connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Поток снимков дашборда (SSE): без буферизации, иначе снимок стоит в
    # буфере nginx, пока не наберётся килобайтами следующих.
    location = /events {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Панель LLM-прокси (#380, эпик #379): страница под /llm/ -- клиентская
    # часть один инлайн-файл, префикс ей безразличен. Её API панель строит
    # от корня origin (utils/connection.ts): /v8/management -- потому вторым
    # location. Оба на петлю: management API прокси отвечает только с неё
    # (allow-remote: false), и этот TLS -- единственный путь к управлению;
    # авторизация -- management-ключ самого прокси.
    #
    # #418 (эпик #413): управление ушло за шлюз. /llm/management.html --
    # шим mop-web (свой вход, iframe на /llm/raw/management.html), /llm/raw/
    # -- gated стоковая панель от mop-web, /v8/management/ -- API-шлюз
    # mop-web: сессия оператора с ролью admin + Bearer из закрытой копии
    # ключа. Алиасы через срез префикса /llm/ закрыты deny: панель строит
    # путь от корня origin, но обход шлюза через префикс не должен
    # работать. Прочее под /llm/ -- у прокси, как было (#411).
    location = /llm/management.html {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /llm/raw/ {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Стоковая панель -- один inline HTML, будущие ассеты -- те же
        # относительные пути: лимит как у LLM-маршрута (#411), стрим --
        # без буферизации и с тем же запасом, что у API.
        client_max_body_size {{ MOP_LLM_REQUEST_MAX_MB }}m;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }

    location /v8/management/ {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Журнал панели стримится: без буферизации, лимит тела как у
        # панели, таймаут -- короче вчерашнего часа: шлюз может ответить
        # быстрее, а зависший upstream виден раньше.
        client_max_body_size {{ MOP_LLM_REQUEST_MAX_MB }}m;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }

    # Exact без слеша -- тоже шлюз: панель строит путь без слеша на
    # корневых запросах, и это не повод уходить мимо префиксного location.
    location = /v8/management {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        client_max_body_size {{ MOP_LLM_REQUEST_MAX_MB }}m;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 75s;
    }

    # Обход шлюза через срез префикса /llm/: /llm/v8/management -- это
    # /v8/management на порту прокси,management-ключа у клиента нет, но
    # путь обязан закрываться здесь, не доходя до прокси.
    location = /llm/v8/management {
        return 403;
    }

    location /llm/v8/management/ {
        return 403;
    }

    # Сами /llm/management* -- мимо прокси: шим живёт на точном
    # /llm/management.html (exact выигрывает у ^~), а всё прочее под
    # префиксом -- со слешем, с .html/ хвостом, suffix-играми -- закрыто
    # одним ^~ блоком.
    location ^~ /llm/management {
        return 403;
    }

    location /llm/ {
        # История и compact проходят здесь же (#411): дефолт nginx
        # отрезал текстовый контекст, а Claude называл 413 лимитом media.
        client_max_body_size {{ MOP_LLM_REQUEST_MAX_MB }}m;
        proxy_pass http://127.0.0.1:{{ MOP_LLM_PROXY_PORT }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ MOP_WEB_PORT }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
{% if MOP_HTTPS_PORT | string == "443" %}

# Открытый HTTP только отсылает на TLS: набранный по привычке http:// адрес
# дашборда не должен отвечать тишиной.
server {
    listen 80;
    listen [::]:80;
    server_name {{ MOP_SERVER_LAN }};
    return 301 https://$host$request_uri;
}
{% endif %}
