# Disk watchdog on every pool node: sysbatch puts one instance on each eligible
# client, periodic runs it by cron. New nodes join the schedule the moment they
# join the cluster. The script itself is distributed by deploy/setup.yml
# (pool play) to /usr/local/bin/pu-sweep.
#
# Hourly, not nightly. It was nightly until 2026-08-28, when a node filled its
# disk between two runs and sat out of the cluster for two days. The sweep is
# cheap when there is no pressure -- tier 3, the only expensive tier, is gated
# on free space -- so the cost of running it 24x more often is a few stats per
# node.
#
# That outage also wedged the schedule, which is worth knowing about: a sysbatch
# child stays `pending` until it can place on EVERY eligible node, and
# prohibit_overlap then blocks each following run. One unreachable node stopped
# the other nodes being swept too. Placement headroom is therefore part of the
# design -- see nomad_reserved_mb in the nomad playbook.
job "pu-cleanup" {
  datacenters = ["{{ MOP_POOL_DC }}"]
  type        = "sysbatch"

  periodic {
    crons            = ["0 * * * *"]
    time_zone        = "Asia/Novosibirsk"
    prohibit_overlap = true
  }

  group "cleanup" {
    task "sweep" {
      driver = "raw_exec"
      user   = "{{ MOP_USER }}"

      config {
        command = "/usr/local/bin/pu-sweep"
      }

      env {
        HOME = "{{ MOP_HOME }}"

        # Escalate to capping live workers' target dirs below this much free.
        # Values of THIS installation ride --extra-vars from `mop deploy`:
        # the defaults live in mop/config.py, and a second source of truth for
        # the same number is how thresholds drift.
        MOP_SWEEP_FREE_MIN_GB = "{{ MOP_SWEEP_FREE_MIN_GB }}"
        MOP_SWEEP_MAX_TARGET = "{{ MOP_SWEEP_MAX_TARGET }}"
        MOP_SWEEP_STALE_DAYS = "{{ MOP_SWEEP_STALE_DAYS }}"
      }

      resources {
        cpu    = 100
        memory = 128
      }
    }
  }
}
