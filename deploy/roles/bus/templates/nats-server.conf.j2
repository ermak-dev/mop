# Шина пула mop. Разворачивается deploy/setup.yml, субъекты описаны в docs/BUS.md.
#
# Без TLS, и это решение, а не упущение. Шина жила под
# сертификатом letsencrypt, и он стоил дороже, чем давал:
#
#   - хука на обновление не было нигде. Certbot обновил бы файл через 90 дней,
#     а nats-server продолжал бы держать в памяти старый, пока его не
#     перезапустят. В этот день верификация отвалилась бы разом на всех узлах,
#     и выглядело бы это как «шина молча умерла» -- чинить пришлось бы
#     аварийным плейбуком по ssh;
#   - защищал он верхний этаж над открытым: RPC Nomad на 4647 не шифрован и не
#     аутентифицирован, и подмена там стоит исполнения кода на узлах.
#
# Осталось два слоя: креды по проектам (ниже) и недоступность 4222 снаружи.
# Второй держится роутером, а не этим файлом. Если узел уезжает из локалки,
# правильный ответ -- оверлей (Tailscale, WireGuard), а не проброс порта.
listen = "0.0.0.0:{{ MOP_NATS_PORT }}"
server_name = "mop"
max_payload = 1MB

# Вход для людей (#96): WebSocket на петле, снаружи до него только через
# TLS-прокси nginx (deploy/roles/proxy, путь /nats). TLS снят здесь по той же
# причине, что и у 4222: сертификат в памяти nats-server не продлить без
# рестарта, а nginx перечитывает его по reload. Пользователи те же, что ниже:
# отдельной авторизации у листенера нет.
websocket {
  listen = "127.0.0.1:{{ MOP_NATS_WS_PORT }}"
  no_tls = true
}

# Права по субъектам -- то, ради чего шину и заводили: раньше на узлы ехал
# management-токен Nomad, и папет мог снести чужие джобы.
#
# Четыре рода пользователей, и делятся они по двум осям сразу -- проект (проект) и
# роль. Первый токен субъекта -- проект, поэтому право «только свой проект»
# выражается одним префиксом.
#
# _INBOX.> обязателен всем, кто задаёт вопросы: без него request-reply молча не
# работает. Это первое, обо что спотыкаются.
#
# Люди входят только через WebSocket (#105), то есть через TLS-прокси nginx:
# на 4222 TLS нет, и пароль человека там шёл бы по LAN открытым текстом.
# Машины (service, узлы, папеты) этим не ограничены: их пароли генерируются
# и ничего, кроме шины, не открывают.
authorization {
  users = [
    # Оператор вне мастер-шелла. Псевдопроект admin -- это отсутствие проекта:
    # все проекты плюс узловой disk (место на хосте -- факт про всех его
    # жильцов). Живёт только на управляющей машине. Раздача кредов --
    # глагол write, и он не отличает оператора от мастера проекта: NATS делит
    # субъекты, а глаголы внутри них проверяет сам агент.
    {
      user: "admin", password: "{{ lookup('password', secrets_dir + '/nats-admin.pass length=32 chars=ascii_letters,digits') }}"
      allowed_connection_types: ["WEBSOCKET"]
      permissions: {
        publish:   { allow: ["mop.>", "_INBOX.>"] }
        subscribe: { allow: ["mop.>", "_INBOX.>"] }
      }
    }

    # Сервисы сервера (#104): дашборд, bootstrap песочниц, сервис кластера.
    # Машина, а не человек: пароль не уходит ни одному оператору, и отзыв
    # доступа человека сервер не задевает. Права пока как у admin -- все
    # проекты и узловые глаголы; сузить их по сервисам -- отдельная работа.
    {
      user: "service", password: "{{ lookup('password', secrets_dir + '/nats-service.pass length=32 chars=ascii_letters,digits') }}"
      permissions: {
        publish:   { allow: ["mop.>", "_INBOX.>"] }
        subscribe: { allow: ["mop.>", "_INBOX.>"] }
      }
    }
{% for op, subs in (MOP_OPERATOR_SUBJECTS | default({})).items() %}

    # Оператор {{ op }} -- человек, а не роль (#84). Права ровно на его
    # проекты: отозвать доступ одному значит убрать одного пользователя, а не
    # сменить пароль всем операторам проекта. Пароль -- там же, где остальные.
    {
      user: "{{ op }}", password: "{{ lookup('password', secrets_dir + '/nats-op-' + op + '.pass length=32 chars=ascii_letters,digits') }}"
      allowed_connection_types: ["WEBSOCKET"]
      permissions: {
        publish:   { allow: [{% for s in subs %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}] }
        subscribe: { allow: [{% for s in subs %}"{{ s }}"{% if not loop.last %}, {% endif %}{% endfor %}] }
      }
    }
{% endfor %}
{% for project in projects %}

    # Мастер проекта {{ project }}: весь свой проект и ничего сверх него.
    {
      user: "master-{{ project }}", password: "{{ lookup('password', secrets_dir + '/nats-master-' + project + '.pass length=32 chars=ascii_letters,digits') }}"
      allowed_connection_types: ["WEBSOCKET"]
      permissions: {
        publish:   { allow: ["mop.{{ project }}.>", "_INBOX.>"] }
        subscribe: { allow: ["mop.{{ project }}.>", "_INBOX.>"] }
      }
    }

    # Папеты проекта {{ project }}. Врапер подсовывает эти креды сессии через
    # MOP_BUS_CONFIG, поэтому `mop mcp` внутри папета достаёт только своих
    # соседей и своего мастера. Управляющий субъект .rpc сюда не входит:
    # печать в чужой TUI и запись файлов остаются за мастером.
    {
      user: "puppet-{{ project }}", password: "{{ lookup('password', secrets_dir + '/nats-puppet-' + project + '.pass length=32 chars=ascii_letters,digits') }}"
      permissions: {
        publish: { allow: ["mop.{{ project }}.node.*.msg", "mop.{{ project }}.all.msg",
                           "mop.{{ project }}.master.>", "mop.{{ project }}.events",
                           "_INBOX.>"] }
        subscribe: { allow: ["_INBOX.>"] }
      }
    }
{% endfor %}
{% for node in nats_nodes %}

    # Агент узла {{ node }}. Проекты он пересекает сознательно: он и есть то, что
    # их разделяет, и обслуживает всех жильцов хоста. Разделение здесь -- по
    # узлу: подписка только на свой, иначе агент мог бы перехватить запрос
    # мастера к соседнему узлу, ответив первым (подписка в NATS не эксклюзивна).
    # Субъект сервера (#62) -- те же креды из процесса задачи Nomad: узел
    # просит bootstrap песочницы за папета, и проект в субъекте сверяет сервер.
    {
      user: "node-{{ node }}", password: "{{ lookup('password', secrets_dir + '/nats-node-' + node + '.pass length=32 chars=ascii_letters,digits') }}"
      permissions: {
        publish: { allow: ["mop.*.master.>", "mop.*.events",
                           "mop.*.node.{{ node }}.msg", "mop.*.server.rpc",
                           "_INBOX.>"] }
        subscribe: { allow: ["mop.*.node.{{ node }}.>", "mop.*.all.msg",
                             "_INBOX.>"] }
      }
    }
{% endfor %}
  ]
}
