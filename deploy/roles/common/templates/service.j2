[Unit]
Description={{ unit.description }}
After={{ unit.after }}
Wants=network-online.target

[Service]
User={{ MOP_USER }}
WorkingDirectory={{ MOP_HOME }}/mop
{# Набор -- config.SERVER_SCOPED (#176); комментарий задачи встаёт перед своей настройкой. #}
{% for e in MOP_SERVER_SCOPED[unit.name] %}
{% if e in unit.notes | default({}) %}
{{ unit.notes[e] }}
{% endif %}
{# systemd делит Environment= по пробелам и раскрывает %-спецификаторы (#185): #}
{# процент удваивается всегда, а значение с пробелом, кавычкой или обратным слешем #}
{# идёт в кавычках с экранированием. Без них -- как прежде, байт в байт. #}
{% set v = lookup('vars', e) | string | replace('%', '%%') %}
{% if [' ', '\t', '"', "'", '\\'] | select('in', v) | list %}
Environment="{{ e }}={{ v | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% else %}
Environment={{ e }}={{ v }}
{% endif %}
{% endfor %}
Environment=PYTHONUNBUFFERED=1
{% for e in unit.before_exec | default([]) %}
{{ e }}
{% endfor %}
ExecStart={{ MOP_HOME }}/mop/bin/mop {{ unit.command }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
