# LLM-прокси пула (#380, эпик #379). Рендерит deploy/roles/llmproxy; ключи --
# lookup('password') в secrets/ контроллера, в репозитории их нет.
# Формат -- config-version 8,/layout как config.example.yaml CLIProxyAPI;
# прокси перечитывает файл по изменению (internal/watcher), рестарт не нужен.

config-version: 8

server:
  # LAN, а не петля: на этом порту узлы и тела ходят за моделями. Порт
  # открывает только LLM API -- client-ключ обязателен; management того же
  # порта отвечает лишь с петли (ниже allow-remote: false).
  host: "0.0.0.0"
  port: {{ MOP_LLM_PROXY_PORT }}

management:
  # Снаружи management не отвечают: единственный путь к панели и её API --
  # TLS-прокси сервера, который как раз с петли и ходит. Отдаёт панель на
  # /llm/ и её API на /v8/management (роль proxy).
  allow-remote: false
  secret-key: "{{ llm_proxy_mgmt_key }}"
  # Панель скачается один раз при первом заходе и дальше стоит на месте:
  # фоновых самообновлений с GitHub нет, версия UI та же, что катилась
  # прогоном (бинарь и панель обновляются вместе, правкой настройки).
  disable-auto-update-panel: true

access:
  # Клиентский ключ прокси: им представляются папеты и мастер. Он же позже
  # уедет узлам строкой MOP_PROXY_KEY в secrets.env (#382) -- как ключ GLM.
  api-keys:
    - "{{ llm_proxy_client_key }}"

oauth:
  # Аккаунты провайдеров (claude/codex OAuth, ключи GLM) -- файлы в этом
  # каталоге; заводятся и живут панелью, репозиторий и плейбуки их не знают.
  auth-dir: "{{ MOP_HOME }}/.config/mop/llm-proxy/auths"

plugins:
  # Система плагинов (дополнительные провайдеры из стора панели) включена:
  # с выключенным прокси предупреждает панель, а завести плагин и обнаружить,
  # что он не работает, -- сюрприз посреди смены провайдера. Каталог --
  # абсолютный: юнит не задаёт WorkingDirectory, и относительный «plugins»
  # читался бы от корня.
  enabled: true
  dir: "{{ MOP_HOME }}/.config/mop/llm-proxy/plugins"
