[Unit]
Description=mop-agent (шина пула: глаголы про слейвов этого узла)
After=network-online.target
Wants=network-online.target

[Service]
User={{ MOP_USER }}
WorkingDirectory={{ mop_home }}
# Имя узла в NOMAD. Оно же — имя в инвентаре и ssh-алиас: клиент Nomad
# объявляется как `name = inventory_hostname`. Угадывать по hostname нельзя,
# агент молча подписался бы не на тот субъект.
Environment=MOP_NODE={{ inventory_hostname }}
# Без неё session.py не найдёт каталог сокетов сессий и уйдёт на запасной
# путь, где никого нет: слейва читались бы как мёртвые при живых сессиях.
# UID спрошен у САМОГО УЗЛА (getent), а не задан настройкой на весь пул.
Environment=XDG_RUNTIME_DIR=/run/user/{{ mop_uid }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m mop.agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
