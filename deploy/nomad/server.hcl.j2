# Сервер Nomad. Все три слушателя -- на всех интерфейсах: и HTTP API для
# мастера, и RPC с serf для клиентов.
#
# HTTP API стоял на loopback, а наружу его отдавал nginx ради TLS. Прокси
# снят: единственный, кто ходит в API, -- мастер, и он в той же локалке.
# Между ними теперь открытый текст, и это осознанно (docs/SECURITY.md):
# слоем ниже RPC 4647 не шифрован и не аутентифицирован СЕГОДНЯ, так что TLS
# над ним защищал бы дверь рядом с проломленной стеной.
#
# ЧТО ДЕРЖИТ ЭТО ЧЕСТНЫМ -- роутер, а не конфиг: наружу проброшены только 443
# и 22. Ставя mop в сети, где это не так, начинать надо отсюда: management-API
# Nomad в интернете закрыт одним лишь ACL.
datacenter = "{{ MOP_POOL_DC }}"
data_dir   = "{{ MOP_NOMAD_DATA }}"
bind_addr  = "0.0.0.0"

advertise {
  http = "{{ MOP_SERVER_LAN }}"
  rpc  = "{{ MOP_SERVER_LAN }}"
  serf = "{{ MOP_SERVER_LAN }}"
}

server {
  enabled          = true
  bootstrap_expect = 1
}

acl {
  enabled = true
}

ui {
  enabled = true
}
