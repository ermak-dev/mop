# Клиент Nomad: дозванивается до сервера ИСХОДЯЩИМ соединением (RPC) и сам
# его никогда не слушает -- отсюда безразличие к CGNAT и к NAT внутри WSL.
# Агент под root, чтобы задачи опускались до пользователя пула; единственный
# включённый драйвер -- raw_exec: папету нужен настоящий $HOME (клоны,
# ~/.claude, ключи), а не chroot.
# Имя узла — ИМЯ В ИНВЕНТАРЕ, а не hostname. Так совпадают три вещи: как узел
# зовут в Nomad, как к нему идёт ssh и как называется субъект его агента на
# шине. Расхождение hostname с именем узла обходилось бы отдельной настройкой
# с таблицей имён и обратным отображением в плейбуке шины.
name       = "{{ inventory_hostname }}"
datacenter = "{{ nomad_datacenter | default(MOP_POOL_DC) }}"
data_dir   = "/opt/nomad/data"
bind_addr  = "127.0.0.1"

# Проверка обновлений у вендора выключена: это единственное, чем кластер сам
# ходил в интернет. При каждом старте и дальше раз в сутки Nomad стучится на
# checkpoint-api.hashicorp.com -- в логах узла это видно как
# `Failed to check for updates`. Пулу оно бесполезно вдвойне: версия задана
# настройкой MOP_NOMAD_VERSION и ставится плейбуком, так что поступить с
# ответом кластеру всё равно нечего.
disable_update_check = true

advertise {
  # A non-loopback advertise is mandatory for all three even with a loopback
  # listener; the go-sockaddr template is evaluated by nomad itself, hence the
  # raw block.
  {% raw -%}
  http = "{{ GetPrivateIP }}"
  rpc  = "{{ GetPrivateIP }}"
  serf = "{{ GetPrivateIP }}"
  {%- endraw %}
}

client {
  enabled = true
  servers = ["{{ MOP_SERVER_LAN }}:{{ MOP_NOMAD_RPC_PORT }}"]

  # В ЧЁМ живёт папет на этом узле. Мастеру это нужно, чтобы знать, чем
  # входить в тело (`mop attach`), а спрашивать узел по шине нельзя: аварийный
  # вход нужен как раз тогда, когда шина и молчит. Значение то же, что в юните
  # агента, и приезжает из одной переменной инвентаря.
  meta {
    mop_driver = "{{ mop_driver | default('host') }}"

    # ЧЬИХ папетов узел умеет обслужить. У узла, где тело равно узлу, — любых:
    # готовить ему заранее нечего, и новый шард он подхватит без прогона
    # deploy. У узла-гипервизора это перечень шардов, чьи ОБРАЗЫ на нём
    # собраны, и ведёт его `mop driver build` динамической meta поверх этой
    # строки. Пустой перечень значит «пока никого» -- и это верно: тело
    # клонируется из образа шарда, а без образа папет не поднимется никогда.
    #
    # Пока строки не было, планировщик ставил на гипервизор папета любого
    # шарда, и тот висел pending навсегда: отказ громкий, но виден только в
    # логе задачи НА УЗЛЕ, а мастер шарда видит лишь «pending».
    mop_shards = "{{ 'any' if (mop_driver | default('host')) == 'host' else '' }}"
  }

  # Опрос метаданных облака выключен, и это НЕ косметика: на нём агент не
  # стартует вовсе. Fingerprinter env_aws ходит на 169.254.169.254, и если
  # адрес не отвергает соединение, а отвечает (домашний роутер вполне может --
  # на одном из узлов он отдал 200 за 70 мс, а дальнейшие запросы SDK повисли), Nomad
  # падает с `fingerprinting failed: ec2imds: GetMetadata, canceled, context
  # deadline exceeded` и узел не регистрируется. Пойман 2026-08-30 при
  # пересоздании кластера: два узла из трёх поднялись, третий не встал.
  #
  # Пул живёт на своих машинах под raw_exec, атрибуты облака ему не нужны ни
  # для размещения, ни для чего-либо ещё.
  options = {
    "fingerprint.denylist" = "env_aws,env_gce,env_azure,env_digitalocean"
  }
{% if mop_reserved_mb | default(0) | int %}
  # Память, отрезанная под чужих жильцов хоста: планировщик считает её
  # неразмещаемой, и пул папетов упирается в «сколько намерил Nomad минус
  # это».
  #
  # Переменная ИНВЕНТАРЯ, а не настройка: число у каждой машины своё, и
  # общей настройкой оно быть не может. Пока места для per-node значений не
  # было, эта карта жила строкой `mate=6962,hyper=118000`, которую плейбук
  # разбирал вручную.
  reserved {
    memory = {{ mop_reserved_mb | int }}
  }
{% endif %}
}

plugin "raw_exec" {
  config {
    enabled = true
  }
}
