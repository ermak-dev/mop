---
# Инвентарь ansible: какие машины есть и какая у каждой роль. Скопируйте
# в inventory.yaml и впишите свои:
#
#     cp inventory.yaml.example inventory.yaml
#
# inventory.yaml в .gitignore и в git не попадает. Имя машины здесь — одно на
# всё: под ним она в Nomad, по нему ansible зовёт `ssh <имя>` без своих ключей
# (адрес и порт знает ~/.ssh/config, и этот файл их не повторяет). Роль — это
# группа, плейбуки mop не знают ни одного конкретного хоста.
#
#   server      сервер: Nomad-сервер и шина NATS, машина, которая включена всегда
#   puppet      узлы пула: на них живут папеты
#   master      управляющая машина: где лежит репозиторий и откуда запускают mop
#   hypervisor  узлы-гипервизоры: тела их папетов — контейнеры LXC
#
# ДВЕ ОСИ. Переменные МАШИНЫ пишутся под самим хостом (что особенного именно
# у этой коробки), общего для роли — в vars группы (что верно каждому её
# узлу). Машина в нескольких ролях перечисляется в каждой — а её переменные
# живут при ОДНОЙ из них.
#
# Числа в кавычках: всё, что читает эти значения — node.env, шаблоны, спеки —
# рассчитано на строки, как их отдавал INI.
#
# У узла есть ещё одно свойство — ДРАЙВЕР: в чём на нём живёт папет
# (docs/DRIVER.md). Умолчание `host` значит «тело равно узлу», и узлу, который
# о драйвере молчит, ничего писать не надо.
#
# Все машины — Debian/Ubuntu: фиксация интерпретатора убирает discovery
# и его предупреждение на каждом прогоне.

all:
  vars:
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Сервер: Nomad-сервер и шина NATS.
    server:
      hosts:
        myserver:

    # Узлы пула: на них живут папеты.
    puppet:
      hosts:
        node1:
        node2:

    # Узлы-гипервизоры Proxmox: тоже узлы пула, поэтому каждый перечислен и в
    # puppet выше, а тело его папетов — контейнер LXC.
    hypervisor:
      hosts:
        myhypervisor:
          # Память под чужих жильцов ЭТОЙ машины: планировщик считает её
          # неразмещаемой. Сколько — арифметика конкретной коробки.
          mop_reserved_mb: "65536"
      vars:
        mop_driver: "pve"
        # Потолки на одно тело: проект вправе попросить меньше своим .mop,
        # больше — нет: решает машина, на которой тело встанет.
        mop_body_mem_cap_mb: "8192"
        mop_body_disk_cap_gb: "50"

    # Управляющая машина: обычно та, на которой вы читаете этот файл.
    master:
      hosts:
        mylaptop:
          # Плейбуки гоняются с неё же, ssh не нужен.
          ansible_connection: "local"
          # Память под её собственную работу как управляющей.
          mop_reserved_mb: "4096"
