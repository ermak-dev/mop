---
# Инвентарь ansible: какие машины есть и какая у каждой роль. Скопируйте
# в inventory.yaml и впишите свои:
#
#     cp inventory.yaml.example inventory.yaml
#

all:
  vars:
    ansible_python_interpreter: /usr/bin/python3

  children:
    # Сервер: Nomad-сервер и шина NATS. Плейбуки гоняются с него же.
    # Менять не нужно, сервер - это localhost, машина, на которой вы запускаете `mop server deploy`
    server:
      hosts:
        localhost:
          ansible_connection: "local"

    # Узлы пула: на них живут папеты.
    puppet:
      hosts:
        node1:
        node2:
      vars:
        # Размеры тела по умолчанию в этой установке; проект вправе попросить
        # меньше в своём .mop/sandbox.yaml, узел — подрезать потолком.
        # Памяти здесь нет: она свойство папета (MOP_MEM_MB в .env и в .mop
        # проекта), и строку mop_mem_mb mop server deploy отвергает. Узел говорит о
        # памяти только потолком mop_body_mem_cap_mb.
        # mop_disk_gb: "50"
        # mop_cores: "4"

    # Узлы Proxmox: тоже узлы пула, поэтому каждый должен быть перечислен и в `puppet` выше. 
    # Если узел указан в этой секции, то он является гипервизором proxmox, а тела его папетов - контейнеры LXC. 
    proxmox:
      hosts:
        node1:
          # Память под чужих жильцов этой машины: планировщик считает её
          # неразмещаемой.
          mop_reserved_mb: "8192"
          # Своя база VMID у КАЖДОГО гипервизора, и одинаковых быть не должно.
          # Из базы считается и срез сети тел, и адрес каждого тела: на общей
          # базе две машины объявят один срез и выдадут один адрес двум разным
          # телам. Прогон на этом отказывается, но узнать об этом из отказа —
          # поздно. Тысяча номеров на машину; сеть MOP_PVE_SUBNET обязана
          # вместить самый большой из них.
          mop_pve_vmid_base: "9000"
          # Хранилище тел и образов этой машины. Строкой хоста, а не общей
          # переменной группы: два гипервизора зовут свои хранилища
          # по-разному (nvmez-data у одного, nvmez2-data у другого), и чужое
          # имя здесь -- образ на системном local-lvm при телах на NVMe (#227).
          # Нет строки -- MOP_PVE_STORAGE установки.
          mop_pve_storage: "local-lvm"
        node2:
          mop_reserved_mb: "8192"
          mop_pve_vmid_base: "10000"
      vars:
        mop_driver: "pve"
        # Потолки на одно тело: проект вправе попросить меньше своим .mop,
        # больше — нет: решает машина, на которой тело встанет. Память --
        # ограничением размещения (#197): папет, чей потолок выше, сюда не
        # встанет. Целое число мегабайт без единиц.
        mop_body_mem_cap_mb: "8192"
        mop_body_disk_cap_gb: "50"
