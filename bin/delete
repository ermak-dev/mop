#!/usr/bin/env python3
"""delete a puppet: mop delete <name>

The clone stays on the node and gets reused if the puppet is brought up
again.
"""
import lib
from mop import nomad, puppets


def main(argv):
    if len(argv) != 1:
        lib.usage(__doc__)
    name = argv[0]
    lib.guard(name)
    nomad.deregister(name)
    print(f"deleted {name} (clone left at {puppets.clone_dir(name)} on the node)")


lib.run(lib.cluster(main))
