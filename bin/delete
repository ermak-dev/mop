#!/usr/bin/env python3
"""удалить слейва: mop delete <имя>

Клон на узле остаётся лежать и переиспользуется, если слейва поднять снова.
"""
import lib
from mop import nomad, slaves


def main(argv):
    if len(argv) != 1:
        lib.usage(__doc__)
    name = argv[0]
    lib.guard(name)
    nomad.deregister(name)
    print(f"удалён {name} (клон остался в {slaves.clone_dir(name)} на узле)")


lib.run(lib.cluster(main))
