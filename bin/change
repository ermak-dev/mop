#!/usr/bin/env python3
"""перенацелить папета: mop change <имя> <git-origin> [--llm ПРОФИЛЬ]

Профиль без --llm сохраняется: смена репозитория не должна молча уронить
папета обратно на claude.
"""
import lib
from mop import config, llm, nomad, puppets


def main(argv):
    profile, args = lib.parse_llm(argv)
    if len(args) != 2:
        lib.usage(__doc__)
    name, origin = args
    lib.guard(name)
    meta = lib.require_job(name).get("Meta") or {}
    old, old_llm = meta.get("origin", "?"), meta.get("llm", config.get("MOP_DEFAULT_LLM"))
    profile = profile or (old_llm if llm.get(old_llm) else config.get("MOP_DEFAULT_LLM"))
    lib.push_llm_keys(profile)
    nomad.register(puppets.job_spec(name, origin, profile))
    print(f"{name}: {old} [{old_llm}] → {origin} [{profile}]")
    print("папет перезапускается с новым репозиторием (клон пересоздаётся врапером)")


lib.run(lib.cluster(main))
