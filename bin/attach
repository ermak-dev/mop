#!/usr/bin/env python3
"""подключиться к tmux-сессии папета: mop attach <имя>

Единственная подкоманда, которая ходит по ssh, а не через шину: живой
терминал глаголом не отдать.
"""
import os

import lib


def main(argv):
    if len(argv) != 1:
        lib.usage(__doc__)
    name = argv[0]
    lib.guard(name)
    a = lib.running_alloc(name)
    # Имя узла в Nomad и есть ssh-алиас: клиент объявляется под именем из
    # инвентаря, а инвентарь берёт способ дозвона из ~/.ssh/config по тому же
    # имени. Таблицы имён между ними нет и не нужно.
    os.execvp("ssh", ["ssh", "-t", a["NodeName"],
                      "tmux", "-L", name, "attach", "-t", name])


lib.run(lib.cluster(main))
