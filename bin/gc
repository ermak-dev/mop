#!/usr/bin/env python3
"""пересоздать свободных папетов на узлах без места: mop gc [--dry]

Узел, где свободно меньше MOP_GC_FREE_MIN_GB, получает рецикл своих
СВОБОДНЫХ папетов (клон к HEAD, target снесён) — не больше
MOP_GC_MAX_PER_RUN за прогон. Запускать оператором, не в мастер-шелле:
давление узла — факт про всех жильцов, а не про один шард.
"""
import lib
from mop import bus, config, puppets


def main(argv):
    dry = argv == ["--dry"]
    if argv and not dry:
        lib.usage(__doc__)
    limit = config.num("MOP_GC_FREE_MIN_GB")
    cap = config.num("MOP_GC_MAX_PER_RUN")
    rows = puppets.puppet_rows()
    nodes = sorted({r["node"] for r in rows if r["node"] != "-"})
    disks = bus.request_many({n: {"verb": "disk"} for n in nodes})

    # Давление и кандидаты: узлы от самого тесного, внутри узла — от самого
    # жирного (место папета уже спрослено глаголом sizes, дополнительных
    # поездок сортировка не стоит).
    plan = []
    for n in nodes:
        d = disks.get(n)
        if isinstance(d, Exception) or not d or d.get("error"):
            why = d if isinstance(d, Exception) else d.get("error") or "нет ответа"
            print(f"  {n}: место неизвестно — {why}")
            continue
        if d["free_gb"] >= limit:
            continue
        cands = [r for r in rows
                 if r["node"] == n and puppets.is_free(r["state"])]
        if not cands:
            print(f"  {n}: свободно {d['free_gb']} ГБ < {limit}, "
                  f"но свободных папетов нет")
            continue
        names = [r["name"] for r in
                 sorted(cands, key=lambda r: -(r.get("disk_kb") or 0))]
        plan.append((d["free_gb"], n, names))
    if not plan:
        print(f"давления нет: на узлах со папетами свободно не меньше {limit} ГБ")
        return

    done = 0
    for free_gb, n, names in sorted(plan):
        for name in names:
            if done >= cap:
                return
            print(f"{n}: свободно {free_gb} ГБ < {limit} — рецикл {name}"
                  + (" [dry]" if dry else ""))
            if not dry:
                puppets.recycle(name)
            done += 1


lib.run(lib.cluster(main))
