#!/usr/bin/env python3
"""диагностика пула: mop doctor [--fix]

Ловит залипания, протухший логин, restart-backoff и исчерпанную квоту модели.
--fix лечит то, что лечится; молчащий агент узла в этот список не входит —
папет при этом может прекрасно работать, а рестарт убьёт работу в клоне.
"""
import sys

import lib
from mop import keys, nomad, puppets
from mop.render import table


def _login():
    """Раздача кредов перед лечением. Тот же вывод, что у `mop login`, — но
    зовём библиотеку, а не соседний командлет: командлет разбирает аргументы
    и печатает, оболочкой друг для друга они быть не должны."""
    results, what, _ = keys.push_login()
    print("раздаю " + " + ".join(what) + " на узлы пула")
    for node in sorted(results):
        print(f"  {node}: {results[node]}")


def treat(issue):
    """Применить лечение к одной проблеме. -> что вышло, одной строкой."""
    action, alloc, name = issue["action"], issue["alloc"], issue["name"]
    try:
        if action == "stop":
            nomad.alloc_stop(alloc["ID"])
            return "alloc stop — Nomad пересоздаст без backoff"
        if action == "model":
            puppets.switch_model(alloc["NodeName"], name, puppets.FALLBACK_MODEL)
            return f"/model {puppets.FALLBACK_MODEL}"
        nomad.alloc_restart(alloc["ID"])
        return "restart"
    except Exception as e:
        return f"{action} не вышел: {str(e)[:80]}"


def main(argv):
    fix = "--fix" in argv
    if set(argv) - {"--fix"}:
        lib.usage(__doc__)
    issues = puppets.diagnose()
    if not issues:
        print("пул здоров: залипаний нет")
        return

    print("\n".join(table([
        (i["name"], i["alloc"]["NodeName"] if i["alloc"] else "-", i["diagnosis"],
         f"[{i['action']}]" if i["action"] and not fix else "")
        for i in issues])))
    if not fix:
        # Подсказку печатаем только если --fix действительно что-то сделает.
        # Иначе она врёт: у «нет квоты модели» и «queued» лечения здесь нет.
        print("\nлечение: mop doctor --fix" if any(i["action"] for i in issues)
              else "\nавтолечения нет — решение оператора")
        return

    print()
    if any(i["action"] == "login+restart" for i in issues):
        if not keys.credentials_fresh():
            sys.exit("локальные креды протухли или битые — сначала залогинься "
                     "в claude на этой машине, потом mop doctor --fix")
        _login()
        print()
    for issue in issues:
        if issue["action"]:
            print(f"  {issue['name']}: {treat(issue)}")
    print("\nконтроль: mop list (и mop tail <имя> для бывших залипших)")


lib.run(lib.cluster(main))
