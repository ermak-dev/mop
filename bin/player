#!/usr/bin/env python3
"""player — claude-плееры поверх Nomad (https://nomad.ermak.dev).

player add [--llm P] [origin]    создать плеера; без origin — взять из git текущего каталога
player list                      плееры (занят/свободен), их LLM, ветки и свободные слоты пула
player delete <name>             остановить и удалить плеера
player change <name> <origin> [--llm P]  перенацелить плеера на другой репозиторий/LLM
player restart <name>            перезапустить зависшего плеера
player attach <name>             подключиться к tmux-сессии плеера на её узле
player tail <name> [-n N] [-f]   хвост tmux-буфера плеера (по умолчанию 10 строк)
player llm                       LLM-профили: чем можно поднимать сиденья и есть ли ключ
player login                     раздать креды claude и ключи LLM-провайдеров на узлы пула
player doctor [--fix]            диагностика пула: залипания, протухший логин, backoff; --fix лечит

Размещение решает Nomad: каждый плеер бронирует 8 ГБ из пула узлов
(на Linux-узлах cgroups делают лимит жёстким). Клон живёт в ~/wk/<имя> на узле
и при delete остаётся лежать — переиспользуется, если плеера поднять снова.
Токен: $NOMAD_TOKEN или ~/.config/nomad/bootstrap.json.

Всё, кроме attach, ходит через API Nomad; ssh нужен только attach ради живого
терминала. Логика живёт в пакете orchestra/ — здесь только разбор аргументов
и печать.
"""
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from orchestra import keys, nomad, seats                       # noqa: E402
from orchestra.render import table                             # noqa: E402


def cwd_origin():
    try:
        return subprocess.run(
            ["git", "remote", "get-url", "origin"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
    except subprocess.CalledProcessError:
        sys.exit("не рабочая копия git и origin не указан: player add <git-origin>")


def project_of(origin):
    return os.path.basename(origin).removesuffix(".git")


def parse_llm(args):
    """Выкусить --llm PROFILE (или --llm=PROFILE) откуда угодно в аргументах.
    -> (профиль | None, остальные аргументы)."""
    llm, rest, it = None, [], iter(args)
    for a in it:
        if a == "--llm":
            llm = next(it, "")
        elif a.startswith("--llm="):
            llm = a.split("=", 1)[1]
        else:
            rest.append(a)
    if llm is not None and llm not in seats.LLM_PROFILES:
        sys.exit(f"нет LLM-профиля {llm or '(пусто)'}; есть: "
                 f"{', '.join(seats.LLM_PROFILES)} (player llm)")
    return llm, rest


def running_alloc(name):
    a = nomad.latest_alloc(name)
    if not a or a["ClientStatus"] != "running":
        sys.exit(f"{name} не running")
    return a


def require_job(name):
    try:
        return nomad.get_job(name)
    except nomad.NotFound:
        sys.exit(f"нет такого плеера: {name}")


def push_llm_keys(llm):
    """Ключи профиля на узлы, с отчётом. Молчит для профилей без ключа."""
    print_target = seats.LLM_KEYS_FILE
    results = keys.push_llm_keys(llm)
    if results is None:
        return
    print(f"раздаю ключи LLM на узлы пула ({print_target})...")
    bad = [f"{n}: {r}" for n, r in sorted(results.items()) if r != "OK"]
    if bad:
        print("  не всем узлам: " + "; ".join(bad))


# ─── команды ─────────────────────────────────────────────────────────────
def cmd_add(args):
    llm, args = parse_llm(args)
    llm = llm or seats.DEFAULT_LLM
    origin = args[0] if args else cwd_origin()
    name = seats.next_name(project_of(origin))
    push_llm_keys(llm)
    nomad.register(seats.job_spec(name, origin, llm))
    print(f"{name}: {origin} [{llm}]")

    node = None
    for _ in range(120):
        a = nomad.latest_alloc(name)
        if a:
            if node is None:
                node = a["NodeName"]
                print(f"  → {node}")
            if a["ClientStatus"] == "running":
                print("  → running")
                return
            if a["ClientStatus"] == "failed":
                print("  → FAILED, смотри: player list / nomad UI")
                return
        time.sleep(1)
    print(f"  → пока {'pending — свободных слотов нет?' if node is None else 'не running'}, "
          f"смотри player list")


def list_hint(rows, origin):
    """Одна подсказка под таблицей: чего именно не хватает прямо сейчас."""
    if not rows:
        return (f"Создайте первый плеер для {project_of(origin)}: player add {origin}"
                if origin else "Создайте плеера: player add <git-origin>")
    if not any(r["state"] == "свободен" for r in rows):
        return (f"\nНет свободных плееров для {project_of(origin)}. "
                f"Создайте: player add {origin}" if origin
                else "\nНет свободных плееров. Создайте: player add <git-origin>")
    if not origin:
        return None
    project = project_of(origin)
    mine = [r for r in rows if project in r["origin"]]
    if not mine:
        return f"\nНет плееров для {project}. Создайте: player add {origin}"
    if not any(r["state"] == "свободен" for r in mine):
        return f"\nВсе плееры для {project} заняты. Создайте ещё: player add {origin}"
    return None


def pool_lines():
    try:
        out = []
        for n in seats.pool():
            if n["status"] != "ready":
                out.append(f"  {n['name']}: {n['status']}")
            elif "error" in n:
                out.append(f"  {n['name']}: {n['error']}")
            else:
                out.append(f"  {n['name']}: свободно {n['free_mb'] / 1024:.0f}/"
                           f"{n['total_mb'] / 1024:.0f} ГБ ({n['slots']} слотов)")
        return out
    except Exception as e:
        return [f"  {nomad.describe_error(e)}"]


def cmd_list(_args):
    rows = seats.seat_rows()
    try:
        origin = cwd_origin()
    except SystemExit:
        origin = None

    if rows:
        print("\n".join(table([(r["name"], r["node"], r["alloc_status"],
                                r["state"], r["llm"], r["origin"]) for r in rows])))
    else:
        print("плееров нет")
    hint = list_hint(rows, origin)
    if hint:
        print(hint)
    print("pool:")
    print("\n".join(pool_lines()))


def cmd_delete(args):
    name = args[0]
    require_job(name)
    nomad.deregister(name)
    print(f"удалён {name} (клон остался в {seats.clone_dir(name)} на узле)")


def cmd_change(args):
    llm, args = parse_llm(args)
    if len(args) != 2:
        sys.exit(__doc__.strip())
    name, origin = args
    meta = require_job(name).get("Meta") or {}
    old, old_llm = meta.get("origin", "?"), meta.get("llm", seats.DEFAULT_LLM)
    # профиль без --llm сохраняется: смена репозитория не должна молча
    # ронять сиденье обратно на claude
    llm = llm or (old_llm if old_llm in seats.LLM_PROFILES else seats.DEFAULT_LLM)
    push_llm_keys(llm)
    nomad.register(seats.job_spec(name, origin, llm))
    print(f"{name}: {old} [{old_llm}] → {origin} [{llm}]")
    print("плеер перезапускается с новым репозиторием (клон пересоздаётся врапером)")


def cmd_restart(args):
    name = args[0]
    a = running_alloc(name)
    print(f"перезапускаю {name} на {a['NodeName']}...")
    try:
        nomad.alloc_restart(a["ID"])
        print("✓ плеер перезапускается")
    except Exception as e:
        print(f"ошибка перезапуска: {e}")
        print(f"Альтернатива: player delete {name} && player add <origin>")


def cmd_attach(args):
    name = args[0]
    a = running_alloc(name)
    host = seats.SSH_ALIAS.get(a["NodeName"], a["NodeName"])
    os.execvp("ssh", ["ssh", "-t", host, "tmux", "-L", name, "attach", "-t", name])


def cmd_llm(_args):
    blob, note = keys.llm_keys_blob()
    have = {l.split("=", 1)[0] for l in (blob or "").splitlines() if "=" in l}
    for name, prof in seats.LLM_PROFILES.items():
        key = prof.get("key")
        if not key:
            state = "логин claude.ai (player login)"
        elif key in have:
            state = f"ключ {key}: есть"
        else:
            state = f"ключ {key}: НЕТ в {seats.LOCAL_KEYS_FILE}"
        base = prof["env"].get("ANTHROPIC_BASE_URL", "api.anthropic.com (по умолчанию)")
        print(f"  {name:8}  {base:38}  {state}")
    if note:
        print(f"\n{note}")
    print("\nplayer add --llm <профиль> [origin]   |   player login раздаёт ключи на узлы")


def cmd_login(_args):
    results, what, note = keys.push_login()
    if note:
        print(f"ключи LLM: {note}")
    print("раздаю " + " + ".join(what) + " на узлы пула")
    for node in sorted(results):
        print(f"  {node}: {results[node]}")


def cmd_doctor(args):
    fix = "--fix" in args
    issues = seats.diagnose()
    if not issues:
        print("пул здоров: залипаний нет")
        return

    print("\n".join(table([
        (i["name"], i["alloc"]["NodeName"] if i["alloc"] else "-", i["diagnosis"],
         f"[{i['action']}]" if i["action"] and not fix else "")
        for i in issues])))
    if not fix:
        # Подсказку печатаем только если --fix действительно что-то сделает.
        # Иначе она врёт: у «нет квоты модели» и «queued» лечения здесь нет.
        print("\nлечение: player doctor --fix" if any(i["action"] for i in issues)
              else "\nавтолечения нет — решение оператора")
        return

    print()
    if any(i["action"] == "login+restart" for i in issues):
        if not keys.credentials_fresh():
            sys.exit("локальные креды протухли или битые — сначала залогинься "
                     "в claude на этой машине, потом player doctor --fix")
        cmd_login([])
        print()
    for issue in issues:
        if issue["action"]:
            print(f"  {issue['name']}: {treat(issue)}")
    print("\nконтроль: player list (и player tail <name> для бывших залипших)")


def treat(issue):
    """Применить лечение к одной проблеме. -> что вышло, одной строкой."""
    action, alloc, name = issue["action"], issue["alloc"], issue["name"]
    try:
        if action == "stop":
            nomad.alloc_stop(alloc["ID"])
            return "alloc stop — Nomad пересоздаст без backoff"
        if action == "model":
            seats.switch_model(alloc, name, seats.FALLBACK_MODEL)
            return f"/model {seats.FALLBACK_MODEL}"
        nomad.alloc_restart(alloc["ID"])
        return "restart"
    except Exception as e:
        return f"{action} не вышел: {str(e)[:80]}"


def appended_since(prev, cur):
    """Строки cur, добавившиеся после prev: ищем самый длинный суффикс prev,
    целиком встречающийся в cur, — всё правее него новое. TUI перерисовывает
    низ экрана, поэтому точки совпадения ищем от длинных к коротким."""
    cur_s = "\n".join(cur)
    for k in (300, 100, 30, 10, 3, 1):
        if k > len(prev):
            continue
        suffix = "\n".join(prev[-k:])
        i = cur_s.rfind(suffix)
        if i >= 0:
            rest = cur_s[i + len(suffix):]
            rest = rest[1:] if rest.startswith("\n") else rest
            return rest.split("\n") if rest else []
    return cur


def parse_tail(args):
    name, lines, follow = None, 10, False
    it = iter(args)
    for a in it:
        if a == "-n":
            v = next(it, None)
            if v is None or not v.lstrip("-").isdigit():
                sys.exit("tail: -n требует число")
            lines = int(v)
        elif a.startswith("-n") and a[2:].isdigit():
            lines = int(a[2:])
        elif a == "-f":
            follow = True
        elif name is None:
            name = a
        else:
            sys.exit(__doc__.strip())
    if name is None:
        sys.exit(__doc__.strip())
    return name, lines, follow


def cmd_tail(args):
    name, lines, follow = parse_tail(args)
    a = running_alloc(name)
    buf = seats.pane_lines(a, name)
    for line in buf[-lines:]:
        print(line, flush=True)
    if not follow:
        return
    try:
        while True:
            time.sleep(2)
            try:
                cur = seats.pane_lines(a, name)
            except Exception:
                # плеер мог перезапуститься/переехать — перецепляемся
                a = running_alloc(name)
                continue
            for line in appended_since(buf, cur):
                print(line, flush=True)
            buf = cur
    except KeyboardInterrupt:
        pass


COMMANDS = {
    "add": (cmd_add, 0, 3),
    "list": (cmd_list, 0, 0),
    "delete": (cmd_delete, 1, 1),
    "change": (cmd_change, 2, 4),
    "restart": (cmd_restart, 1, 1),
    "attach": (cmd_attach, 1, 1),
    "tail": (cmd_tail, 1, 4),
    "login": (cmd_login, 0, 0),
    "llm": (cmd_llm, 0, 0),
    "doctor": (cmd_doctor, 0, 1),
}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] not in COMMANDS:
        sys.exit(__doc__.strip())
    fn, lo, hi = COMMANDS[argv[0]]
    args = argv[1:]
    if not lo <= len(args) <= hi:
        sys.exit(__doc__.strip())
    try:
        fn(args)
    except (ConnectionError, RuntimeError, LookupError) as e:
        sys.exit(str(e))
    except nomad.ApiError as e:
        sys.exit(nomad.describe_error(e))


if __name__ == "__main__":
    main()
