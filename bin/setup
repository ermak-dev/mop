#!/usr/bin/env python3
"""this machine's own dependencies: mop setup [--operator]

Installs what the machine running mop needs and nothing for the pool: the
pool's nodes and bodies are ansible's business (mop deploy). Without a flag
the machine is the controller, the one that runs mop deploy: ansible with
the ansible.posix collection, rsync, git, curl, and the python libraries
mop is written on. With --operator it is an operator's machine: the python
libraries and git, and a word about claude if it is not in PATH.

Running it again does nothing: every item is checked before it is
installed. apt goes through sudo, pip installs per user, and the list of
libraries lives in mop/deps.py, one for both roles.
"""
import importlib
import shutil
import subprocess

import lib
from mop import deps


def have_command(name):
    if "." in name:            # коллекция ansible, а не бинарник
        if not shutil.which("ansible-galaxy"):
            return False
        r = subprocess.run(["ansible-galaxy", "collection", "list", name],
                           capture_output=True, text=True)
        return r.returncode == 0 and name in r.stdout
    # git и curl проверяются как команды; ansible — по своему бинарнику.
    return shutil.which("ansible-playbook" if name == "ansible" else name) is not None


def have_module(name):
    try:
        importlib.import_module(name)
        return True
    except ImportError:
        return False


def run(cmd):
    print("  " + " ".join(cmd))
    subprocess.run(cmd, check=True)


def main(argv):
    if argv not in ([], ["--operator"]):
        lib.usage(__doc__)
    role = "operator" if argv else "controller"
    todo = deps.plan(role, have_command, have_module)
    if todo["apt"]:
        run(["sudo", "apt-get", "install", "-y"] + todo["apt"])
    if todo["galaxy"]:
        run(["ansible-galaxy", "collection", "install"] + todo["galaxy"])
    if todo["pip"]:
        run(["python3", "-m", "pip", "install", "--user", "--break-system-packages"]
            + todo["pip"])
    if not any(todo.values()):
        print(f"{role}: nothing to install")
    else:
        print(f"{role}: installed")
    if role == "operator" and not shutil.which("claude"):
        print("claude is not in PATH: install Claude Code before mop master")


lib.run(main)
