#!/bin/bash
# List of subcommands. It's also the answer to `mop` with no arguments.
skip=("common" "help" "mop" "lib.py")
echo "mop — pool of claude puppets on top of Nomad, message bus on top of NATS"
echo
echo "  mop <subcommand> [arguments]"
echo
for f in "$BIN_DIR"/*; do
    [[ -f "$f" ]] || continue          # __pycache__ и прочий сор — не подкоманды
    name="$(basename "$f")"
    for s in "${skip[@]}"; do [[ "$name" == "$s" ]] && continue 2; done
    # Первая строка после shebang и есть однострочное описание командлета.
    desc="$(sed -n '2,4p' "$f" | grep -m1 -oP '(?<=^# ).*|(?<=^""")[^"]*' || true)"
    printf "    %-9s %s\n" "$name" "$desc"
done
echo
echo "  mop help          this list"
