#!/usr/bin/env python3
"""создать папета: mop add [--llm ПРОФИЛЬ] [git-origin]

Без origin берётся origin текущей рабочей копии. Имя выбирается само:
<проект>-<номер>. Размещение решает Nomad — папет бронирует 8 ГБ из пула.
"""
import os
import time

import lib
from mop import config, nomad, puppets


def main(argv):
    profile, args = lib.parse_llm(argv)
    if len(args) > 1:
        lib.usage(__doc__)
    profile = profile or config.get("MOP_DEFAULT_LLM")
    origin = args[0] if args else lib.cwd_origin()
    shard = puppets.shard_of(origin)
    # Курица и яйцо: у нового проекта ещё нет пользователя в конфиге NATS, и
    # папет поднимется, но к шине не подключится — прочитается как «АГЕНТ
    # МОЛЧИТ» на пустом месте. Лучше отказать здесь, чем разбираться там.
    if not os.path.exists(lib.shard_creds(shard)):
        lib.usage(f"шарда {shard} ещё нет на шине.\nЗаведи его: mop deploy {origin}")
    name = puppets.next_name(shard)
    lib.push_llm_keys(profile)
    nomad.register(puppets.job_spec(name, origin, profile))
    print(f"{name}: {origin} [{profile}]")

    node = None
    for _ in range(120):
        a = nomad.latest_alloc(name)
        if a:
            if node is None:
                node = a["NodeName"]
                print(f"  → {node}")
            if a["ClientStatus"] == "running":
                print("  → running")
                return
            if a["ClientStatus"] == "failed":
                print("  → FAILED, смотри: mop list / nomad UI")
                return
        time.sleep(1)
    print(f"  → пока {'pending — свободных слотов нет?' if node is None else 'не running'}, "
          f"смотри mop list")


lib.run(lib.cluster(main))
