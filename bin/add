#!/usr/bin/env python3
"""создать слейва: mop add [--llm ПРОФИЛЬ] [git-origin]

Без origin берётся origin текущей рабочей копии. Имя выбирается само:
<проект>-<номер>. Размещение решает Nomad — слейв бронирует 8 ГБ из пула.
"""
import time

import lib
from mop import nomad, slaves


def main(argv):
    llm, args = lib.parse_llm(argv)
    if len(args) > 1:
        lib.usage(__doc__)
    llm = llm or slaves.DEFAULT_LLM
    origin = args[0] if args else lib.cwd_origin()
    name = slaves.next_name(lib.project_of(origin))
    lib.push_llm_keys(llm)
    nomad.register(slaves.job_spec(name, origin, llm))
    print(f"{name}: {origin} [{llm}]")

    node = None
    for _ in range(120):
        a = nomad.latest_alloc(name)
        if a:
            if node is None:
                node = a["NodeName"]
                print(f"  → {node}")
            if a["ClientStatus"] == "running":
                print("  → running")
                return
            if a["ClientStatus"] == "failed":
                print("  → FAILED, смотри: mop list / nomad UI")
                return
        time.sleep(1)
    print(f"  → пока {'pending — свободных слотов нет?' if node is None else 'не running'}, "
          f"смотри mop list")


lib.run(main)
