#!/bin/bash -e
# развернуть: mop deploy [nomad|pool|homelab|claude|all] [origin|шард ...]
#
# ПРОДУКТ -- первые две цели, и только они переносимы между установками:
#
#   nomad     кластер Nomad: сервер и клиенты. ГДЕ стоит слейв.
#   pool      шина, агент и сторож диска на узлах, креды. КАК с ним говорить.
#
# Остальное -- установка автора из examples/, пулу не нужное:
#
#   homelab   окружение узлов: тулчейн проектов, прокси перед API.
#   claude    личные скиллы и MCP рабочего стола.
#
# Порядок: nomad -> homelab -> claude -> pool. Пакет mop на узлы привозит pool,
# и юнит агента он же запускает -- до него запускать нечего.
#
# Это единственная дорога на узел мимо шины. Дороги через неё (alloc exec)
# больше нет, поэтому упавшего агента и битые креды чинят только отсюда --
# и по этой же причине deploy не имеет права ничего занимать у самого mop.

WHAT="${1:-all}"
shift || true      # остаток -- шарды, которых в пуле ещё нет

# Плейбуки находятся по одному лишь соглашению о пути: `net setup <имя>`
# разворачивается в ~/etc/<имя>/setup.yml, таблицы имён нигде нет. Симлинки и
# есть эта таблица, поэтому deploy их заводит сам, а не требует от оператора.
link() {
    local name="$1" target="$2"
    local want="$PROJECT_HOME/$target"
    if [[ "$(readlink -f "$HOME/etc/$name" 2>/dev/null)" != "$want" ]]; then
        mkdir -p "$HOME/etc"
        ln -sfn "$want" "$HOME/etc/$name"
        ok "  симлинк ~/etc/$name -> $want"
    fi
}

# Настройки установки едут в плейбуки тем же путём, что и список шардов, --
# --extra-vars. Плейбуки .env не читают САМИ: на узлах его нет (rsync
# исключает -- там креды GitLab), а два способа добраться до одних значений
# однажды разойдутся.
SETTINGS="$("$BIN_DIR/mop" config --json)"

play() {
    local book="$1"; shift
    section "ansible: $book"
    ansible-playbook -i "$INVENTORY" "$PROJECT_HOME/$book" \
        --extra-vars "$SETTINGS" "$@"
}

# Шарды считает `mop shards`: ростер Nomad плюс память плюс то, что назвали в
# аргументах. Плейбук заводит по пользователю NATS на каждый и раскатывает
# креды -- мастеру и слейвам. Пустой список законен: пустой пул, мастеров ещё
# нет.
# Отдаём ОБЪЕКТОМ, а не парой ключ=значение: `--extra-vars mop_shards=[...]`
# ansible принимает как строку, и цикл в шаблоне честно проходится по её
# символам, порождая пользователей `master-[`, `master-"` и так далее.
shards_json() {
    "$BIN_DIR/mop" shards "$@" \
        | python3 -c "import json,sys; print(json.dumps({'mop_shards': [l.strip() for l in sys.stdin if l.strip()]}))"
}

if [[ ! -f "$INVENTORY" ]]; then
    fail "нет инвентаря $INVENTORY -- он общий с остальными плейбуками и живёт вне этого репозитория"
    exit 1
fi

# Плейбуки находятся по имени каталога в ~/etc, поэтому цель симлинка может
# меняться, а имя -- нет: ~/etc/site.yml импортирует ~/etc/nomad/setup.yml по
# этому пути и о переезде каталога внутри репозитория не знает.
link nomad   deploy/nomad
link nats    deploy
link homelab examples/homelab

case "$WHAT" in
    pool)          play deploy/setup.yml --extra-vars "$(shards_json "$@")" ;;
    nomad)         play deploy/nomad/setup.yml ;;
    homelab)       play examples/homelab/setup.yml ;;
    claude)        play examples/homelab/claude.yml ;;
    nats)          # прежнее имя pool; оставлено, чтобы не ломать привычку
                   play deploy/setup.yml --extra-vars "$(shards_json "$@")" ;;
    all)
        play deploy/nomad/setup.yml
        play examples/homelab/setup.yml
        play examples/homelab/claude.yml
        play deploy/setup.yml --extra-vars "$(shards_json "$@")"
        ;;
    *)
        fail "mop deploy [nomad|pool|homelab|claude|all] [origin|шард ...]"
        exit 1
        ;;
esac

section "проверка"
# Прогон без неё не отличает «плейбук зелёный» от «пул отвечает»: агент,
# упавший в бесконечный реконнект, systemd вполне устраивает.
"$BIN_DIR/mop" list
