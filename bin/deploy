#!/bin/bash -e
# deploy: mop deploy [origin|shard ...]
#
# Полный прогон установки, всегда целиком и одним плейбуком -- site.yml
# склеивает импортами все слои (номad, окружение узлов, шину), поэтому
# ansible-процесс один и PLAY RECAP один: строка на машину, суммирующая
# все слои. Отдельных целей нет: чинить упавшее дешевле повторным прогоном,
# чем вспоминанием, какая цель за что отвечала. Порядок слоёв живёт в site.yml.
#
# Это единственная дорога на узел мимо шины. Дороги через неё (alloc exec)
# больше нет, поэтому упавшего агента и битые креды чинят только отсюда --
# и по этой же причине deploy не имеет права ничего занимать у самого mop.

# Плейбуки находятся по одному лишь соглашению о пути: `net setup <имя>`
# разворачивается в ~/etc/<имя>/setup.yml, таблицы имён нигде нет. Симлинки и
# есть эта таблица, поэтому deploy их заводит сам, а не требует от оператора.
link() {
    local name="$1" target="$2"
    local want="$PROJECT_HOME/$target"
    if [[ "$(readlink -f "$HOME/etc/$name" 2>/dev/null)" != "$want" ]]; then
        mkdir -p "$HOME/etc"
        ln -sfn "$want" "$HOME/etc/$name"
        ok "  symlink ~/etc/$name -> $want"
    fi
}

# Настройки установки едут в плейбуки тем же путём, что и список шардов, --
# --extra-vars. Плейбуки .env не читают САМИ: на узлах его нет (rsync
# исключает -- там креды GitLab), а два способа добраться до одних значений
# однажды разойдутся.
SETTINGS="$("$BIN_DIR/mop" config --json)"

play() {
    local book="$1"; shift
    section "ansible: $book"
    ansible-playbook -i "$INVENTORY" "$PROJECT_HOME/$book" \
        --extra-vars "$SETTINGS" "$@"
}

# Шарды считает `mop shards`: ростер Nomad плюс память плюс то, что назвали в
# аргументах. Плейбук заводит по пользователю NATS на каждый и раскатывает
# креды -- мастеру и папетам. Пустой список законен: пустой пул, мастеров ещё
# нет.
# Отдаём ОБЪЕКТОМ, а не парой ключ=значение: `--extra-vars mop_shards=[...]`
# ansible принимает как строку, и цикл в шаблоне честно проходится по её
# символам, порождая пользователей `master-[`, `master-"` и так далее.
shards_json() {
    "$BIN_DIR/mop" shards "$@" \
        | python3 -c "import json,sys; print(json.dumps({'mop_shards': [l.strip() for l in sys.stdin if l.strip()]}))"
}

if [[ ! -f "$INVENTORY" ]]; then
    fail "no inventory $INVENTORY -- create it from the example: cp inventory.yaml.example inventory.yaml"
    exit 1
fi

# Файлы окружения тел называет MOP_BODY_EXTRA, а лежат они в УСТАНОВКЕ и в git
# не попадают (setup.yaml -- копия setup.yaml.example). Проверяем здесь: у
# ansible пропавший include_tasks валит прогон в середине, когда полпула уже
# перенастроено, и читается это как поломка плейбука, а не как «файла нет».
while read -r extra; do
    [[ -z "$extra" || -f "$PROJECT_HOME/$extra" ]] && continue
    fail "no body environment file $extra -- create it from the example: cp setup.yaml.example setup.yaml (or empty MOP_BODY_EXTRA in .env)"
    exit 1
done < <(python3 -c "
import json, sys
for part in json.load(sys.stdin).get('MOP_BODY_EXTRA', '').split(','):
    print(part.strip())" <<<"$SETTINGS")

# Прежние цели запуска. Отвергаем, а не молча трактуем как имя шарда: старая
# привычка `mop deploy pool` завела бы на шине пользователя master-pool, и
# разбирались бы с этим уже по симптомам.
case "$1" in
    nomad|pool|homelab|claude|nats|all)
        fail "run targets are gone: mop deploy [origin|shard ...]"
        exit 1
        ;;
esac

# Плейбуки находятся по имени каталога в ~/etc, поэтому цель симлинка может
# меняться, а имя -- нет: ~/etc/site.yml импортирует ~/etc/nomad/setup.yml по
# этому пути и о переезде каталога внутри репозитория не знает.
link nomad   deploy/nomad
link nats    deploy
# Манифесты шардов (#25): режутся из ORIGIN библиотечным разбором ЗДЕСЬ,
# на управляющей машине. Origin'ы -- из памяти шардов (`mop shards`): она
# узнаёт origin в момент завода шарда аргументом, и отдельного списка в
# настройках не существует (#33). Плейбук получает готовые пути и не
# заводит второго, снисходительного парсера у себя. Недоступный origin
# валит прогон громко: названный шард обязан существовать.
manifests_json() {
    local origins
    origins="$("$BIN_DIR/mop" shards --origins)"
    MOP_ORIGINS="$origins" python3 - <<'PY'
import json
import os
from mop import manifest
out = {}
for origin in (os.environ.get("MOP_ORIGINS") or "").splitlines():
    origin = origin.strip()
    if not origin:
        continue
    got = manifest.fetch(origin)
    entry = {"asks": got["asks"]}
    for side in ("node_tasks", "ws_vars", "ws_tasks"):
        if got[side]:
            entry[side] = got[side]
    out[got["shard"]] = entry
    for k in got["alien"]:
        print(f"  {got['shard']}/.mop: {k} is not a project's to set — ignored",
              flush=True)
print(json.dumps({"mop_manifests": out}))
PY
}

play site.yml --extra-vars "$(shards_json "$@")" \
              --extra-vars "$(manifests_json)"

section "check"
# Прогон без неё не отличает «плейбук зелёный» от «пул отвечает»: агент,
# упавший в бесконечный реконнект, systemd вполне устраивает.
"$BIN_DIR/mop" list
