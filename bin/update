#!/usr/bin/env python3
"""обновить папета: mop update <имя> [git-origin] [--llm ПРОФИЛЬ] [--fresh]

Меняет то, что названо, и сохраняет остальное: без origin папет остаётся на
своём репозитории, без --llm — на своём профиле. Смена репозитория молча
уронить профиль обратно на дефолт не должна, и наоборот.

По умолчанию поднявшийся claude продолжает последний разговор каталога, так
что смена профиля переводит на другую модель уже НАЧАТУЮ работу. Разрешение
разовое: рестарт аллокации спеку не перечитывает, а лечение — это рестарт, и
вылеченный папет не обязан возвращаться в контекст, на котором залип.
--fresh поднимает с чистой сессией.
"""
import lib
from mop import config, llm, nomad, puppets


def main(argv):
    profile, args = lib.parse_llm(argv)
    fresh = "--fresh" in args
    args = [a for a in args if a != "--fresh"]
    if not 1 <= len(args) <= 2:
        lib.usage(__doc__)
    name = args[0]
    lib.guard(name)
    meta = lib.require_job(name).get("Meta") or {}
    old, old_llm = meta.get("origin"), meta.get("llm", config.get("MOP_DEFAULT_LLM"))
    if not old:
        # Джоб без origin в Meta — не папет: ростер их и не показывает.
        lib.usage(f"{name}: в спеке нет origin — это не папет пула")
    origin = args[1] if len(args) > 1 else old
    profile = profile or (old_llm if llm.get(old_llm) else config.get("MOP_DEFAULT_LLM"))
    lib.push_llm_keys(profile)
    # История каталога переживает только смену ПРОФИЛЯ: при смене репозитория
    # врапер пересоздаёт клон, а разговор остался от прежнего проекта — поднять
    # его в чужом репозитории значит выдать папету чужой контекст за свой.
    cont = not fresh and origin == old
    nomad.register(puppets.job_spec(name, origin, profile, cont=cont))
    moved = f"{old} [{old_llm}] → {origin} [{profile}]" if origin != old \
        else f"{origin}: {old_llm} → {profile}" if profile != old_llm \
        else f"{origin} [{profile}], без изменений"
    print(f"{name}: {moved}")
    print("папет перезапускается" + (", история каталога поднимется" if cont
          else " с чистой сессией" + (" (--fresh)" if fresh else ": репозиторий другой")))


lib.run(lib.cluster(main))
