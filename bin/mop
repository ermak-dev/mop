#!/bin/bash -pe
# mop — the single entry point into the pool, and the only file in bin/. The
# subcommands are modules of the package (mop/cli, docs and dispatch there);
# this launcher only finds the project and hands over.
#
# Симлинк резолвим до конца: наружу торчит ~/bin/mop, а дерево проекта надо
# найти относительно настоящего файла, а не относительно ссылки.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( /usr/bin/dirname "$SOURCE" )" && pwd )"
    SOURCE="$(/usr/bin/readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT="$( cd -P "$( /usr/bin/dirname "$SOURCE" )/.." && pwd )"
# Root composition не импортирует checkout, PYTHONPATH, usersite или .env.
# Installer обязан положить весь launcher/release в immutable root-owned tree.
if [[ "${1:-}" == "host-root" ]]; then
    shift
    exec /usr/bin/python3 -I -S -B "$PROJECT/mop/node/host_root.py" "$@"
fi
# Standby MCP получает только scope/deadline, не argv с bearer или wire paths.
if [[ "${1:-}" == "host-body-mcp" ]]; then
    shift
    exec /usr/bin/python3 -I -S -B "$PROJECT/mop/client/body_entry.py" "$@"
fi
# Пакет находится по PYTHONPATH, а не по текущему каталогу: зовут из любого.
export PYTHONPATH="$PROJECT${PYTHONPATH:+:$PYTHONPATH}"
# Процессом, а не source: `mop mcp` говорит по stdio, и ему нужен чистый
# обмен, без наследования чужого шелла.
exec python3 -P -m mop.cli "$@"
