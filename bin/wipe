#!/usr/bin/env python3
"""снести рабочую копию слейва: mop wipe <имя>

Клон сбрасывается к HEAD (несохранённое и untracked пропадают), target-каталог
удаляется целиком. Агент откажет, если tmux-сессия жива: голый wipe — для
остановленного слейва, полный цикл — mop recycle.
"""
import sys

import lib
from mop import nomad, slaves


def main(argv):
    if len(argv) != 1:
        lib.usage(__doc__)
    name = argv[0]
    lib.guard(name)
    alloc = nomad.latest_alloc(name)
    if not alloc:
        sys.exit(f"{name}: нет аллокации — узел неизвестен")
    r = slaves.wipe(alloc["NodeName"], name)
    print(f"{name}: клон сброшен к HEAD, target снесён ({r['target']})")


lib.run(lib.cluster(main))
