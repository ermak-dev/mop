#!/usr/bin/env python3
"""cc-send — послать сообщение живой сессии claude code через её uds-инбокс.

cc-send list                        живые сессии: имя, pid, статус, каталог
cc-send <цель> <текст>              отправить сообщение
cc-send <цель> -                    текст со stdin
cc-send <цель> <текст> --wait[=N]   отправить и ждать, пока сессия освободится

<цель> — имя сессии (ermak-c3), pid, рабочий каталог или путь к сокету.

  --priority now|next|later   куда в очередь сессии (по умолчанию next)
  --mode bypass|prompting     каким режимом прав представиться (по умолчанию bypass)
  --quiet                     молча, только код возврата

Протокол целиком описан в CHANNEL.md — здесь только то, что нужно, чтобы
понять код. Коротко: сокет сессии принимает NDJSON, по объекту в строке.

Почему сообщение всегда едет в конверте <cross-session-message>: сиденье,
запущенное с --dangerously-skip-permissions, НЕ отдаёт модели сообщение от
отправителя, который не заявил свой режим прав, — оно кладёт его в
"held"-очередь и ждёт, пока живой человек нажмёт "Deliver". Для воркера,
у которого человека нет, это неотличимо от потери сообщения. Заявка режима
живёт атрибутом from-mode внутри ТЕКСТА, а не полем кадра.

Почему auth-кадр шлём, хотя на linux он не обязателен: без него сессия
принимает сообщение, но НЕ принимает подписку notify_when_idle (проверено:
с токеном peer_idle_notice приходит, без токена — тишина). Токен лежит рядом
с файлом сессии и читается только владельцем.
"""
import argparse
import glob
import hashlib
import json
import os
import socket
import sys
import threading
import time
import uuid

SESSIONS = os.path.expanduser("~/.claude/sessions")
CONNECT_TIMEOUT = 5


# ─── сессии ──────────────────────────────────────────────────────────────
def sessions():
    """Все файлы сессий, что удалось прочитать. Мёртвые тоже: живость решает
    сокет, а не файл — файл переживает грязную смерть процесса."""
    out = []
    for f in sorted(glob.glob(f"{SESSIONS}/*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
        except Exception:
            continue
        if d.get("messagingSocketPath"):
            out.append(d)
    return out


def alive(sock_path):
    """Единственная достоверная проба живости: слушает ли кто-то сокет."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(1)
    try:
        s.connect(sock_path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def resolve(target):
    """Цель -> файл сессии. Путь к сокету принимаем как есть: он может
    указывать на сессию, чей файл нам не читается."""
    if target.endswith(".sock"):
        return {"messagingSocketPath": target, "pid": None, "name": target}
    found = [d for d in sessions()
             if str(d.get("pid")) == target
             or d.get("name") == target
             or d.get("cwd") == target
             or os.path.realpath(d.get("cwd") or "") == os.path.realpath(target)]
    if not found:
        sys.exit(f"нет сессии: {target} (cc-send list)")
    if len(found) > 1:
        # Имена сессий выводятся из каталога и не уникальны; молча взять
        # первую — значит однажды написать не тому.
        names = ", ".join(f"{d['name']}[{d['pid']}]" for d in found)
        sys.exit(f"под '{target}' подходит несколько сессий: {names} — уточни pid")
    return found[0]


def peer_token(sock_path):
    """Ключ инбокса: ~/.claude/sessions/<pid>.<sha256(канонический путь)>.key"""
    h = hashlib.sha256(os.path.realpath(sock_path).encode()).hexdigest()
    for f in glob.glob(f"{SESSIONS}/*.{h}.key"):
        try:
            with open(f) as fh:
                return json.load(fh)["peerToken"]
        except Exception:
            continue
    return None


# ─── протокол ────────────────────────────────────────────────────────────
def envelope(body, from_addr=None, from_name=None, mode="bypass"):
    """Конверт заявки о режиме прав. Порядок атрибутов фиксирован: приёмник
    разбирает конверт регуляркой и проверяет, что пересборка даёт исходную
    строку байт в байт — переставленные атрибуты просто не будут распознаны,
    и сообщение молча уедет в held."""
    attrs = ""
    if from_addr:
        attrs += f' from="{from_addr}"'
    if from_name:
        attrs += f' from-name="{from_name}"'
    if mode:
        attrs += f' from-mode="{mode}"'
    return f"<cross-session-message{attrs}>\n{body}\n</cross-session-message>"


def write_frames(sock_path, frames, token):
    """Одно соединение, строки, закрыть. Ответ в этом же соединении не
    приходит никогда — квитанции сессия шлёт отдельным коннектом на адрес
    из поля from."""
    line = ""
    if token:
        line += json.dumps({"type": "auth", "token": token}) + "\n"
    for f in frames:
        line += json.dumps(f, ensure_ascii=False) + "\n"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(CONNECT_TIMEOUT)
    try:
        s.connect(sock_path)
    except FileNotFoundError:
        sys.exit(f"инбокс не найден: {sock_path} — сессия умерла или переехала")
    except ConnectionRefusedError:
        sys.exit(f"инбокс мёртв: {sock_path} — процесс не слушает (протухший файл сессии)")
    try:
        s.sendall(line.encode())
    finally:
        s.close()


class Inbox:
    """Свой инбокс для квитанций и peer_idle_notice.

    Имя и каталог не произвольные: приёмник шлёт ответ, только если адрес
    лежит в том же каталоге сокетов и назван как <pid>.sock — иначе он
    отказывается писать в чужое пространство имён и молча роняет ответ."""

    def __init__(self, sockets_dir):
        self.path = os.path.join(sockets_dir, f"{os.getpid()}.sock")
        self.frames = []
        self._event = threading.Event()
        try:
            os.unlink(self.path)
        except FileNotFoundError:
            pass
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.srv.bind(self.path)
        os.chmod(self.path, 0o600)
        self.srv.listen(8)
        threading.Thread(target=self._serve, daemon=True).start()

    def _serve(self):
        while True:
            try:
                conn, _ = self.srv.accept()
            except OSError:
                return
            buf = b""
            while True:
                chunk = conn.recv(65536)
                if not chunk:
                    break
                buf += chunk
            conn.close()
            for ln in buf.decode(errors="replace").splitlines():
                if not ln.strip():
                    continue
                try:
                    self.frames.append(json.loads(ln))
                except ValueError:
                    continue
                self._event.set()

    def wait_idle(self, orig_msg_id, timeout):
        deadline = time.time() + timeout
        while time.time() < deadline:
            for f in self.frames:
                if (f.get("action") == "peer_idle_notice"
                        and f.get("orig_msg_id") == orig_msg_id):
                    return f
            self._event.wait(1)
            self._event.clear()
        return None

    def close(self):
        try:
            self.srv.close()
        finally:
            try:
                os.unlink(self.path)
            except FileNotFoundError:
                pass


def user_frame(content, priority, from_addr=None):
    f = {"msgV": 1, "msg_id": str(uuid.uuid4()), "type": "user",
         "message": {"role": "user", "content": content}, "priority": priority}
    if from_addr:
        f["from"] = from_addr
    return f


# ─── команды ─────────────────────────────────────────────────────────────
def cmd_list():
    rows = []
    for d in sessions():
        rows.append((
            d.get("name") or "-",
            str(d.get("pid")),
            "жива" if alive(d["messagingSocketPath"]) else "мертва",
            d.get("status") or "-",
            d.get("cwd") or "-",
        ))
    if not rows:
        print("живых сессий нет")
        return
    w = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print(f"{r[0]:{w[0]}}  {r[1]:{w[1]}}  {r[2]:{w[2]}}  {r[3]:{w[3]}}  {r[4]}")


def cmd_send(args):
    sess = resolve(args.target)
    sock = sess["messagingSocketPath"]
    if not alive(sock):
        sys.exit(f"{sess.get('name')}: инбокс не слушает — сессия мертва")

    body = sys.stdin.read().rstrip("\n") if args.message == "-" else args.message
    if not body.strip():
        sys.exit("пустое сообщение отправлять нечего")

    token = peer_token(sock)
    inbox = Inbox(os.path.dirname(sock)) if args.wait is not None else None
    from_addr = f"uds:{inbox.path}" if inbox else None
    try:
        content = envelope(body, from_addr, os.path.basename(sys.argv[0]), args.mode)
        frame = user_frame(content, args.priority, from_addr)
        write_frames(sock, [frame], token)
        if not args.quiet:
            print(f"-> {sess.get('name')} [{sess.get('pid')}] msg_id={frame['msg_id']}")

        if inbox is None:
            return 0

        # Подписка отдельным кадром и со своим msg_id: notice приходит
        # с orig_msg_id именно ПОДПИСКИ, а не сообщения.
        sub = str(uuid.uuid4())
        write_frames(sock, [{"msgV": 1, "msg_id": sub, "type": "control",
                             "action": "notify_when_idle", "from": from_addr,
                             "from_mode": args.mode}], token)
        notice = inbox.wait_idle(sub, args.wait)
        if notice is None:
            if not args.quiet:
                print(f"ждал {args.wait}s — сессия не сообщила, что освободилась")
            return 2
        if not args.quiet:
            state = notice.get("state", "?")
            detail = notice.get("detail")
            print(f"<- {state}" + (f": {detail}" if detail else ""))
        return 0
    finally:
        if inbox:
            inbox.close()


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "list":
        cmd_list()
        return 0
    p = argparse.ArgumentParser(add_help=False, usage=__doc__)
    p.add_argument("target")
    p.add_argument("message")
    p.add_argument("--priority", choices=["now", "next", "later"], default="next")
    p.add_argument("--mode", choices=["bypass", "prompting"], default="bypass")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--wait", nargs="?", type=int, const=600, default=None,
                   help="ждать peer_idle_notice, по умолчанию 600 секунд")
    if len(sys.argv) < 3:
        sys.exit(__doc__.strip())
    return cmd_send(p.parse_args())


if __name__ == "__main__":
    sys.exit(main() or 0)
