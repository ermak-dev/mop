#!/usr/bin/env python3
"""cc-send — послать сообщение живой сессии claude code через её uds-инбокс.

cc-send list                        живые сессии: имя, pid, статус, каталог
cc-send <цель> <текст>              отправить сообщение
cc-send <цель> -                    текст со stdin
cc-send <цель> <текст> --wait[=N]   отправить и ждать, пока сессия освободится

<цель> — имя сессии (ermak-c3), pid, рабочий каталог или путь к сокету.

  --priority now|next|later   куда в очередь сессии (по умолчанию next)
  --mode bypass|prompting     каким режимом прав представиться (по умолчанию bypass)
  --quiet                     молча, только код возврата

Протокол описан в CHANNEL.md, реализация — в mop/session.py. Здесь
только разбор аргументов и печать.
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from mop import session                                  # noqa: E402
from mop.render import table                             # noqa: E402


def cmd_list():
    rows = [(d.get("name") or "-", str(d.get("pid")),
             "жива" if session.socket_alive(d["messagingSocketPath"]) else "мертва",
             d.get("status") or "-", d.get("cwd") or "-")
            for d in session.sessions()]
    print("\n".join(table(rows)) if rows else "живых сессий нет")


def cmd_send(args):
    sess = session.find(args.target)
    sock = sess["messagingSocketPath"]
    if not session.socket_alive(sock):
        sys.exit(f"{sess.get('name')}: инбокс не слушает — сессия мертва")

    body = sys.stdin.read().rstrip("\n") if args.message == "-" else args.message
    if not body.strip():
        sys.exit("пустое сообщение отправлять нечего")

    r = session.send(sock, body, priority=args.priority, mode=args.mode,
                     from_name="cc-send", wait_idle=args.wait or 0)
    if args.quiet:
        return 0 if (args.wait is None or r["idle"]) else 2
    print(f"-> {sess.get('name')} [{sess.get('pid')}] msg_id={r['msg_id']}")
    if args.wait is None:
        return 0
    if r["idle"] is None:
        print(f"ждал {args.wait}s — сессия не сообщила, что освободилась")
        return 2
    detail = r["idle"].get("detail")
    print(f"<- {r['idle'].get('state', '?')}" + (f": {detail}" if detail else ""))
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "list":
        cmd_list()
        return 0
    if len(sys.argv) < 3:
        sys.exit(__doc__.strip())
    p = argparse.ArgumentParser(add_help=False, usage=__doc__)
    p.add_argument("target")
    p.add_argument("message")
    p.add_argument("--priority", choices=session.PRIORITIES, default="next")
    p.add_argument("--mode", choices=session.MODES, default="bypass")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--wait", nargs="?", type=int, const=600, default=None,
                   help="ждать peer_idle_notice, по умолчанию 600 секунд")
    try:
        return cmd_send(p.parse_args())
    except (LookupError, ConnectionError) as e:
        sys.exit(str(e))


if __name__ == "__main__":
    sys.exit(main() or 0)
