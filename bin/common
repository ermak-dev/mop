#!/bin/bash
# Common environment for the commandlets.
#
# МОЛЧИТ, и это требование, а не стиль: `mop mcp` разговаривает по stdio, и
# любая строка, напечатанная отсюда, порвала бы протокол MCP на первом же кадре.
export BIN_DIR="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
export PROJECT_HOME="$(dirname "$BIN_DIR")"
export PYTHONPATH="$PROJECT_HOME${PYTHONPATH:+:$PYTHONPATH}"

# Инвентарь — часть установки: живёт в корне проекта, в git не попадает.
export INVENTORY="${INVENTORY:-$PROJECT_HOME/inventory.ini}"

# Настройки самого ansible — часть ПРОДУКТА, и находятся они по этой
# переменной. Свой ansible.cfg ansible ищет относительно текущего каталога, а
# зовут его и `mop deploy`, и `mop driver build`, из любого места. Здесь —
# потому что common подключают все командлеты.
export ANSIBLE_CONFIG="${ANSIBLE_CONFIG:-$PROJECT_HOME/ansible.cfg}"

# Где искать роли. Переменной, а не строкой в ansible.cfg: относительные пути
# там ansible разрешает от ТЕКУЩЕГО каталога, а абсолютные были бы литералом
# конкретной машины в репозитории. Здесь они собираются из PROJECT_HOME.
#
# Роли есть только у ПРОДУКТА. Установка автора (examples/) обходится парой
# файлов задач: ролевое дерево ей ничего не даёт, а читать его дольше.
export ANSIBLE_ROLES_PATH="${ANSIBLE_ROLES_PATH:-$PROJECT_HOME/deploy/roles}"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; BOLD=$'\033[1m'; NC=$'\033[0m'
export RED GREEN BOLD NC

section() { echo -e "\n${BOLD}$*${NC}"; }
fail()    { echo -e "${RED}$*${NC}" >&2; }
ok()      { echo -e "${GREEN}$*${NC}"; }
