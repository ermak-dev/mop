#!/usr/bin/env python3
"""garbage on the pool's nodes: mop sweep [--dry]

Objects no puppet owns any more. Nomad is the authority: a body whose name
is in no job is an orphan, and on a hypervisor an orphan is a running
container holding memory and disk that nothing accounts for.

Run this as the operator, not from a master shell: what stands on a node is
a fact about every tenant, not about one shard — the same reason `mop gc`
and `mop disk` live outside a master's reach.

Two kinds, deliberately of different weight. An ORPHAN is destroyed: its
puppet is gone and the body cannot come back to anyone. A BUILD BODY is only
named — a sealed image always stands still, so one that runs is either a
build happening right now or a build that broke, and from here those two
look the same. Destroying someone's running build costs more than leaving
rubbish until the next sweep.

`mop driver sweep` is the other half and stays: it runs ON a node, knows
nothing of Nomad, and judges by the absence of a tmux session. That is the
right signal for a node left alone; this one is the right signal for the
machine that holds the register.
"""
import lib
from mop import bus, nomad, puppets
from mop.render import table


def main(argv):
    dry = argv == ["--dry"]
    if argv and not dry:
        lib.usage(__doc__)

    nodes = sorted(nomad.ready_nodes())
    if not nodes:
        print("no ready nodes")
        return 0
    answers = bus.request_many({n: {"verb": "junk"} for n in nodes})

    # Узел, который не ответил, — не пустой узел. Промолчавший считался бы
    # «без тел», и его сироты уехали бы из отчёта молча, а молчание здесь
    # означает ровно противоположное: мы про него ничего не знаем.
    silent = {n: bus.failure(answers.get(n)) for n in nodes}
    silent = {n: why for n, why in silent.items() if why}
    for n, why in silent.items():
        print(f"  ! {n}: {why} — not swept, its bodies are unknown")

    # Все джобы пула, а не только своего шарда: сирота чужого проекта — такой
    # же занятый контейнер, и «не мой» не делает его чьим-то.
    heard = [n for n in nodes if n not in silent]
    if not heard:
        # Ни один не ответил — это НЕ «чисто». Печатать здесь «нечего
        # убирать» значило бы отчитаться об осмотре, которого не было.
        print(f"no node answered — nothing was examined, let alone swept")
        return 1

    # Пустой список джобов — это не «весь пул мусор», это Nomad, который
    # ничего не сказал. Снос по такому признаку был бы худшим из возможных
    # исходов, и предохранитель тут того же рода, что у `mop driver sweep`:
    # признак, верный поодиночке, перестаёт им быть, когда совпадает у всех.
    known = {j["ID"] for j in puppets.jobs()}
    if not known:
        print("Nomad lists no puppets at all — that reads as 'every body is "
              "garbage', which is never the right answer; refusing to sweep")
        return 1

    rows = puppets.classify_junk({n: answers[n] for n in heard}, known)
    if not rows:
        print(f"nothing to sweep on {len(heard)} node(s)")
        return 1 if silent else 0

    out = [("NODE", "KIND", "NAME", "WHY")]
    for r in rows:
        out.append((r["node"], r["kind"], r["name"], r["detail"]))
    print("\n".join(table(out)))

    doomed = [r for r in rows if r["sweepable"]]
    if not doomed:
        print("\nnothing here is safe to destroy without a human")
        return 1 if silent else 0
    if dry:
        for r in doomed:
            print(f"  would destroy {r['name']} on {r['node']}")
        return 0

    gone = 0
    for r in doomed:
        a = bus.request(r["node"], "wipe", name=r["name"], timeout=600)
        why = a.get("error")
        print(f"  {r['name']}: {why or 'destroyed'}")
        gone += 0 if why else 1
    print(f"{gone} of {len(doomed)} destroyed")
    return 1 if silent or gone != len(doomed) else 0


lib.run(lib.cluster(main))
