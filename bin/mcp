#!/usr/bin/env python3
"""MCP-сервер пула: тот же пул инструментами для claude

Запускается как `mop mcp`, транспорт stdio.

Транспорт stdio, запускается дочерним процессом сессии — мастера или слейва.

ТРИ ПРОФИЛЯ, и решают их факты, а не флаги:

  * токен Nomad + MOP_SHARD -> мастер шарда: канал и управление джобами, но
    только своим срезом пула (`mop master` ставит обе переменные);
  * токен без шарда -> оператор: то же самое, но по всему пулу;
  * без токена -> узел: один канал, ростер собирается опросом самой шины.

Так узел физически не может позвать то, чего ему не положено, вместо того
чтобы не звать по уговору.

Почему не встроенный SendMessage: он видит только этот хост плюс облачные и
bridge-сессии, а слейва пула живут на других узлах. Здесь доставка идёт через
шину, и хост значения не имеет.

КАНАЛ ДВУСТОРОННИЙ. У `send` три адреса, а не два: слейв пула, сессия этого
хоста и МАСТЕР — по его инбоксу на шине. Третьего не было, и петля мастера
стояла на песке: слейв отчитывался, `session.find` не находил мастера на своём
хосте, исключение приезжало модели строкой «Error executing tool send», а
мастер читал молчание и шёл смотреть чужой экран глазами.

Сокет сессии host-local, поэтому до него дотягивается агент, который на том же
узле и живёт (mop/agent.py). Протокол канала — CHANNEL.md, субъекты шины —
BUS.md, устройство сервера — MCP.md.
"""
import functools
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from mcp.server.mcpserver import MCPServer                     # noqa: E402
from mcp.types import ToolAnnotations                          # noqa: E402

from mop import bus, keys, nomad, session, slaves         # noqa: E402
from mop.render import table                              # noqa: E402

app = MCPServer(
    "mop",
    instructions=(
        "Пул claude-слейвов поверх Nomad.\n\n"
        "ЭТО ЕДИНСТВЕННЫЙ КАНАЛ СВЯЗИ С ПУЛОМ. Чтобы написать слейву или узнать, "
        "кто свободен, бери `send` и `agents` отсюда. Встроенные "
        "SendMessage/ListAgents для этого не годятся: они видят только сессии "
        "ЭТОГО ЖЕ хоста, а слейвы живут на разных узлах — на соседнем узле "
        "встроенный поиск молча никого не найдёт. Здесь доставка идёт через "
        "Nomad, и хост значения не имеет.\n\n"
        "`agents` — кто есть и в каком состоянии, `send` — сообщение слейву, "
        "`tail` — что у него на экране. Перед диспатчем всегда сверяйся с "
        "`agents`: «свободен» там означает, что в клоне нет несохранённой "
        "работы, а не просто что сессия молчит."
    ),
)

def has_nomad_token():
    """Есть ли у нас право управлять кластером.

    Это факт, а не флаг: на узле файла с токеном просто нет — его перестали
    туда возить, когда канал переехал на шину. Профиль сервера выводится
    отсюда, поэтому узел не может позвать управление джобами даже по ошибке."""
    try:
        nomad.token()
        return True
    except Exception:
        return False


MASTER = has_nomad_token()
# Свой адрес для вестей от агентов. Уникален на процесс: два терминала,
# открытые в одном проекте, иначе разбирали бы вести друг друга.
MASTER_ID = f"{os.uname().nodename}-{os.getpid()}"
MY_INBOX = bus.inbox(MASTER_ID)


def loud(fn):
    """Причина отказа — в ответ, а не в исключение.

    Исключение из инструмента приезжает модели строкой «Error executing tool
    send» БЕЗ причины, и это худший вид отказа: слейв, у которого не было
    маршрута до мастера, увидел ровно её — три попытки, три разных адреса,
    один и тот же глухой текст и никакой возможности понять, что дело в
    адресе. Инструмент обязан называть себя и причину."""
    @functools.wraps(fn)
    def wrap(*a, **kw):
        try:
            return fn(*a, **kw)
        except Exception as e:
            return f"{fn.__name__}: {e or type(e).__name__}"
    return wrap


def tool(**kw):
    """Инструмент сервера. Тело всегда под loud."""
    def deco(fn):
        return app.tool(**kw)(loud(fn))
    return deco


def master_tool(**kw):
    """Инструмент, который есть только у мастера. На узле функция остаётся
    обычной питоновской и просто не попадает в список инструментов."""
    def deco(fn):
        return tool(**kw)(fn) if MASTER else fn
    return deco


READ_ONLY = ToolAnnotations(readOnlyHint=True)
DESTRUCTIVE = ToolAnnotations(destructiveHint=True)
SLASH_ALLOWED = ("/model", "/clear", "/compact", "/rc", "/status", "Escape")
MAX_WAIT = 600
# Опрос мастеров короче обычного запроса: мастер отвечает из памяти, а ждёт
# его КАЖДЫЙ вызов agents — gather не знает, сколько ответов ему ждать, и
# честно досиживает до таймаута.
MASTERS_WAIT = 2


# ─── адресация ───────────────────────────────────────────────────────────
def slave_alloc(name):
    """Живая аллокация слейва. Путь к сокету НИКОГДА не кэшируем: после
    рестарта слейва меняется pid, а с ним и имя сокета."""
    alloc = nomad.latest_alloc(name)
    if not alloc:
        raise LookupError(f"{name}: нет аллокации — слейв не размещён")
    if alloc["ClientStatus"] != "running":
        raise LookupError(f"{name}: аллокация {alloc['ClientStatus']}, не running")
    return alloc


def slave_node(name):
    """Узел слейва — адрес на шине.

    У мастера узел берётся из ростера Nomad. На узле ростера нет, и мы
    спрашиваем сам пул: чей агент признаёт этот слейв своим."""
    if MASTER:
        return slave_alloc(name)["NodeName"]
    for answer in bus.gather("local"):
        if name in (answer.get("slaves") or {}):
            return answer["node"]
    raise LookupError(f"{name}: ни один агент пула не признаёт этот слейв своим")


def master_socket():
    """Инбокс сессии, которая нас запустила, — для асинхронных уведомлений.

    Основной путь — переменная окружения, которую claude кладёт потомкам.
    Запасной нужен, если окружение вычистили: идём вверх по цепочке
    родителей и ищем pid, у которого есть файл сессии."""
    sock = os.environ.get("CLAUDE_CODE_MESSAGING_SOCKET")
    if sock:
        return sock
    by_pid = {str(d.get("pid")): d for d in session.sessions()}
    pid = os.getpid()
    for _ in range(24):
        try:
            with open(f"/proc/{pid}/status") as f:
                ppid = next(l.split()[1] for l in f if l.startswith("PPid:"))
        except (OSError, StopIteration):
            return None
        if ppid in by_pid:
            return by_pid[ppid]["messagingSocketPath"]
        pid = int(ppid)
        if pid <= 1:
            return None
    return None


def my_session():
    """Файл сессии, которая нас запустила: имя, каталог, pid."""
    sock = master_socket()
    if not sock:
        return None
    for d in session.sessions():
        if d.get("messagingSocketPath") == sock:
            return d
    return None


def my_name():
    """Как я представляюсь адресату — и каким именем он мне ответит.

    У мастера это его инбокс на шине (`MASTER_ID`): имя сессии claude адресом
    быть не может — оно выводится из каталога, не уникально и шине неизвестно.
    Оператор, спрашивавший «пингани их, пусть ответят», назвал слейвам именно
    имя сессии, и ответить по нему было некуда.

    У слейва это имя его джоба: оно же имя клона, им же слейв адресуется в
    send. Берём из каталога СЕССИИ, а не из cwd процесса: сервер запускают
    откуда угодно, а сессия слейва всегда стоит в своём клоне."""
    if MASTER:
        return MASTER_ID
    cwd = (my_session() or {}).get("cwd") or os.getcwd()
    base = os.path.basename(os.path.realpath(cwd))
    return base if base.startswith(slaves.JOB_PREFIX) else MASTER_ID


def on_inbox(m):
    """Что приехало в инбокс мастера: вести агентов и ОТЧЁТЫ СЛЕЙВОВ.

    Возвращённое становится ответом на запрос — так у слейва появляется вердикт
    доставки вместо факта отправки. Агент вести публикует и ответа не ждёт:
    для него не меняется ничего.

    `who` — единственный глагол, который не кладут в сессию: им спрашивают
    общий инбокс шарда, «кто из мастеров жив»."""
    if m.get("verb") == "who":
        d = my_session() or {}
        return {"master": MASTER_ID, "shard": bus.SHARD,
                "session": d.get("name"), "cwd": d.get("cwd")}
    sock = master_socket()
    if not sock:
        return {"error": f"у мастера {MASTER_ID} нет сессии — весть класть некуда"}
    # priority по умолчанию later: так кладёт вести агент, и перебивать ход
    # мастера уведомлением о простое незачем. Слейв со своим отчётом просит
    # громче — и имеет право, отчёта мастер ждёт.
    r = session.send(sock, m.get("text") or "",
                     priority=m.get("priority") or "later",
                     from_name=m.get("from") or m.get("node") or "mop")
    return {"msg_id": r["msg_id"]}


# ─── инструменты: канал ──────────────────────────────────────────────────
@tool(annotations=READ_ONLY, description=(
    "Кому можно писать: слейвы пула по ВСЕМ узлам, мастера своего шарда и "
    "сессии claude на этой машине. Полнее встроенного ListAgents, который "
    "видит только этот хост. Для слейва показывает достоверное состояние "
    "(свободен/занят/завис/нет квоты/несохранённая работа в клоне), "
    "LLM-профиль и репозиторий; для мастера — адрес, которым ему отвечают."))
def agents(project: str = "") -> str:
    out = _roster(project) if MASTER else _roster_from_bus()
    out += _masters()

    here = [(d.get("name") or "-", str(d.get("pid")), d.get("status") or "-",
              d.get("cwd") or "-")
             for d in session.sessions()
             if session.socket_alive(d["messagingSocketPath"])]
    if here:
        out += ["", "сессии на этой машине:",
                *table([("СЕССИЯ", "PID", "СТАТУС", "КАТАЛОГ"), *here])]
    return "\n".join(out)


def _roster(project):
    """Ростер мастера: Nomad знает про слейва то, чего не знает узел, —
    состояние аллокации, профиль LLM, репозиторий."""
    rows = [("СЛЕЙВ", "УЗЕЛ", "АЛЛОК", "СОСТОЯНИЕ", "LLM", "РЕПОЗИТОРИЙ")]
    for r in slaves.slave_rows():
        if project and project not in r["origin"]:
            continue
        rows.append((r["name"], r["node"], r["alloc_status"], r["state"],
                     r["llm"], r["origin"]))
    return ["слейва пула:", *table(rows)] if len(rows) > 1 else ["слейва пула: нет"]


def _roster_from_bus():
    """Ростер узла: у него нет токена Nomad, поэтому пул опрашивается сам.

    Колонок меньше, и это честно: аллокацию и репозиторий узлу взять неоткуда.
    Для того, ради чего слейв смотрит в agents — кому написать и кто свободен, —
    хватает имени, узла и состояния."""
    rows = [("СЛЕЙВ", "УЗЕЛ", "СОСТОЯНИЕ")]
    try:
        answers = bus.gather("local")
    except bus.BusError as e:
        return [f"шина недоступна: {e}"]
    for answer in sorted(answers, key=lambda a: a.get("node") or ""):
        for name, facts in sorted((answer.get("slaves") or {}).items()):
            rows.append((name, answer.get("node") or "?", slaves.slave_state(facts)))
    return ["слейва пула:", *table(rows)] if len(rows) > 1 else ["слейва пула: нет"]


def _masters():
    """Мастера шарда: кому отсюда можно ОТВЕТИТЬ.

    Реестра нет намеренно — спрашиваем общий инбокс шарда, и живой мастер это
    тот, кто отозвался. Слейву эта строка нужна как воздух: без неё адрес
    мастера негде взять, кроме конверта уже полученного письма.

    Мастеру она показывает соседа. Мастеров на проект можно держать сколько
    угодно, но раздавать задачи вдвоём, не зная друг о друге, нельзя: два пинга
    одному слейву в один вечер как раз этим и кончились."""
    try:
        found = bus.gather("who", timeout=MASTERS_WAIT,
                           subj=bus.inbox(bus.ALL_MASTERS))
    except bus.BusError as e:
        return ["", f"мастера шарда {bus.SHARD}: шина недоступна ({e})"]
    if not found:
        return ["", f"мастеров шарда {bus.SHARD} на шине нет"]
    rows = [("МАСТЕР (адрес для send)", "СЕССИЯ", "КАТАЛОГ")]
    for d in sorted(found, key=lambda d: str(d.get("master"))):
        mine = " (это я)" if d.get("master") == MASTER_ID else ""
        rows.append((str(d.get("master")), (d.get("session") or "-") + mine,
                     d.get("cwd") or "-"))
    return ["", "мастера шарда:", *table(rows)]


@tool(description=(
    "Послать сообщение слейву пула, мастеру шарда или сессии на этой машине. "
    "ЕДИНСТВЕННЫЙ рабочий способ достучаться и до слейва, и до мастера: "
    "встроенный SendMessage дотягивается только до сессий этого же хоста и на "
    "соседнем узле молча никого не найдёт. `to`: имя слейва (sl-<проект>-<n>), "
    "адрес мастера из agents или из конверта полученного сообщения "
    "(from-name), имя/pid локальной сессии. Возвращает вердикт доставки, а не "
    "факт отправки. notify_when_idle=true не блокирует: когда адресат "
    "освободится, уведомление придёт отдельным сообщением."))
def send(to: str, message: str, priority: str = "next",
         notify_when_idle: bool = False, wait_seconds: int = 0) -> str:
    if priority not in session.PRIORITIES:
        return f"priority должен быть одним из {', '.join(session.PRIORITIES)}"
    if not message.strip():
        return "пустое сообщение отправлять нечего"

    # Три адреса, и порядок разбора не произвольный. Слейв узнаётся префиксом
    # джоба — это единственное имя, которое строит сам пул. Дальше пробуем свой
    # хост: сессия рядом дешевле и не занимает шину. Всё остальное — мастер,
    # потому что больше адресов не бывает, и «не нашёл здесь» обязано вести к
    # нему, а не в LookupError: ровно этим отчёты слейвов и терялись.
    if to.startswith(slaves.JOB_PREFIX):
        return _send_to_slave(to, message, priority, notify_when_idle, wait_seconds)
    here = _local_session(to)
    if here:
        return _send_locally(here, message, priority, wait_seconds)
    return _send_to_master(to, message, priority)


def _local_session(target):
    """Сессия на ЭТОЙ машине или None, если её здесь нет.

    `Ambiguous` не глушим и наверх пускаем: «здесь такой нет» разрешает искать
    адресата дальше, на шине, а «их тут несколько» обязано остановить —
    молча взять первую значит однажды написать не тому."""
    try:
        return session.find(target)
    except session.Ambiguous:
        raise
    except LookupError:
        return None


def _send_to_master(name, message, priority):
    """Обратный канал: слейв -> мастер, в его инбокс на шине.

    Адрес мастера слейв не придумывает: он приезжает в конверте каждого
    сообщения (from-name) и лежит в ростере. Ответа ждём — вердикт доставки
    здесь важнее, чем где-либо ещё: отчёт слейва и есть главный сигнал петли,
    и «отправлено» вместо «доставлено» означало бы ровно то молчание, из-за
    которого мастер идёт читать чужой экран глазами."""
    try:
        # from — поле, а не имя параметра: в питоне это ключевое слово.
        r = bus.ask(name, "message", text=message, priority=priority,
                    **{"from": my_name()})
    except bus.BusError as e:
        return f"{name}: НЕ ДОСТАВЛЕНО — {e}"
    if "error" in r:
        return f"{name}: НЕ ДОСТАВЛЕНО — {r['error']}"
    return f"{name}: доставлено (msg_id={r.get('msg_id')})"


def _send_to_slave(name, message, priority, notify_when_idle, wait_seconds):
    """Доставка через агента узла.

    Ожидание простоя целиком уехало на узел: подписку держит агент рядом с
    сокетом и, дождавшись, публикует в инбокс мастера. Здесь больше нет
    фонового потока — он ждал внутри аллокации и умирал вместе с ней."""
    wait = min(max(wait_seconds, 0), MAX_WAIT)
    try:
        result = bus.request(slave_node(name), "send", name=name, message=message,
                             priority=priority, wait=wait,
                             notify=bool(notify_when_idle and not wait),
                             # Кто пишет. Едет в конверт полем from-name, и
                             # подсказка канала называет его слейву как адрес
                             # для ответа: без этого «ответь мне» указывает в
                             # никуда, а слейв узнаёт об этом уже отказом.
                             from_name=my_name(),
                             reply_to=MY_INBOX, timeout=wait + bus.TIMEOUT)
    except bus.BusError as e:
        return f"{name}: НЕ ДОСТАВЛЕНО — {e}"
    if "error" in result:
        return f"{name}: НЕ ДОСТАВЛЕНО — {result['error']}"

    verdict = f"{name}: доставлено (msg_id={result['msg_id']})"
    if wait:
        verdict += f", простой: {result.get('idle') or 'не дождался за ' + str(wait) + 'с'}"
    if notify_when_idle and not wait:
        verdict += "; уведомлю, когда освободится"
    return verdict


def _send_locally(sess, message, priority, wait_seconds):
    sock = sess["messagingSocketPath"]
    if not session.socket_alive(sock):
        return f"{sess.get('name')}: инбокс не слушает — сессия мертва"
    r = session.send(sock, message, priority=priority, from_name=my_name(),
                     wait_idle=min(max(wait_seconds, 0), MAX_WAIT))
    verdict = f"{sess.get('name')}: доставлено (msg_id={r['msg_id']})"
    if wait_seconds:
        verdict += f", простой: {(r['idle'] or {}).get('state') or 'не дождался'}"
    return verdict


@tool(annotations=READ_ONLY, description=(
    "Хвост tmux-буфера слейва — единственный способ увидеть то, чего нет в "
    "состоянии: held-диалог чужого сообщения, промпт логина, жалобу на квоту."))
def tail(name: str, lines: int = 40, grep: str = "") -> str:
    buf = slaves.pane_lines(slave_node(name), name)
    if grep:
        buf = [l for l in buf if grep.lower() in l.lower()]
    return "\n".join(buf[-max(1, lines):]) or "(пусто)"


# ─── инструменты: управление ─────────────────────────────────────────────
@master_tool(annotations=READ_ONLY, description=(
    "Ёмкость пула: узлы, свободная память и сколько ещё слейвов туда влезет."))
def pool() -> str:
    rows = [("УЗЕЛ", "СТАТУС", "СВОБОДНО", "СЛОТОВ")]
    for n in slaves.pool():
        if n["status"] != "ready":
            rows.append((n["name"], n["status"], "-", "-"))
        elif "error" in n:
            rows.append((n["name"], "ready", n["error"], "-"))
        else:
            rows.append((n["name"], "ready",
                         f"{n['free_mb'] / 1024:.0f}/{n['total_mb'] / 1024:.0f} ГБ",
                         str(n["slots"])))
    return "\n".join(table(rows))


@master_tool(annotations=DESTRUCTIVE, description=(
    "Управление слейвами: add (создать), remove (удалить), restart "
    "(перезапустить залипшее), retarget (сменить репозиторий или LLM). "
    "Клон при remove остаётся на узле и переиспользуется."))
def slave(action: str, name: str = "", origin: str = "", llm: str = "") -> str:
    if action == "add":
        return _slave_add(origin, llm)
    if not name:
        return f"{action}: нужно имя слейва"
    if action == "remove":
        nomad.get_job(name)
        nomad.deregister(name)
        return f"удалён {name} (клон остался в {slaves.clone_dir(name)})"
    if action == "restart":
        nomad.alloc_restart(slave_alloc(name)["ID"])
        return f"{name}: перезапускается"
    if action == "retarget":
        return _slave_retarget(name, origin, llm)
    return "action: add | remove | restart | retarget"


def _slave_add(origin, llm):
    if not origin:
        return "add: нужен origin репозитория"
    llm = llm or slaves.DEFAULT_LLM
    if llm not in slaves.LLM_PROFILES:
        return f"нет LLM-профиля {llm}; есть: {', '.join(slaves.LLM_PROFILES)}"
    keys.push_llm_keys(llm)
    name = slaves.next_name(os.path.basename(origin).removesuffix(".git"))
    nomad.register(slaves.job_spec(name, origin, llm))
    return f"{name}: {origin} [{llm}] — размещается, состояние смотри в agents"


def _slave_retarget(name, origin, llm):
    meta = nomad.get_job(name).get("Meta") or {}
    origin = origin or meta.get("origin")
    # профиль без явного llm сохраняется: смена репозитория не должна молча
    # ронять слейв обратно на claude
    llm = llm or meta.get("llm", slaves.DEFAULT_LLM)
    if llm not in slaves.LLM_PROFILES:
        return f"нет LLM-профиля {llm}; есть: {', '.join(slaves.LLM_PROFILES)}"
    keys.push_llm_keys(llm)
    nomad.register(slaves.job_spec(name, origin, llm))
    return f"{name} -> {origin} [{llm}], перезапускается"


@master_tool(annotations=DESTRUCTIVE, description=(
    "Диагностика пула: залипания, протухший логин, restart-backoff, "
    "исчерпанная квота модели. С fix=true лечит то, что лечится."))
def doctor(fix: bool = False) -> str:
    issues = slaves.diagnose()
    if not issues:
        return "пул здоров: залипаний нет"
    rows = [(i["name"], i["alloc"]["NodeName"] if i["alloc"] else "-",
             i["diagnosis"], i["action"] or "лечения нет") for i in issues]
    out = table([("СИДЕНЬЕ", "УЗЕЛ", "ДИАГНОЗ", "ЛЕЧЕНИЕ"), *rows])
    if not fix:
        return "\n".join(out)

    if any(i["action"] == "login+restart" for i in issues):
        if not keys.credentials_fresh():
            return "\n".join(out + ["", "локальные креды протухли — залогинься в "
                                    "claude на управляющей машине, потом doctor(fix=true)"])
        keys.push_login()
    done = [f"  {i['name']}: {_treat(i)}" for i in issues if i["action"]]
    return "\n".join(out + ["", *done])


def _treat(issue):
    action, alloc, name = issue["action"], issue["alloc"], issue["name"]
    try:
        if action == "stop":
            nomad.alloc_stop(alloc["ID"])
            return "alloc stop — Nomad пересоздаст без backoff"
        if action == "model":
            slaves.switch_model(alloc["NodeName"], name, slaves.FALLBACK_MODEL)
            return f"/model {slaves.FALLBACK_MODEL}"
        nomad.alloc_restart(alloc["ID"])
        return "restart"
    except Exception as e:
        return f"{action} не вышел: {str(e)[:80]}"


@master_tool(annotations=DESTRUCTIVE, description=(
    "Слэш-команда в TUI слейва. Нужна отдельно, потому что каналом слэш-"
    "команды не проходят: сообщение кладётся в очередь с skipSlashCommands. "
    "Escape СНИМАЕТ залипший диалог, не отвечая на него: залипший слейв "
    "невидим для ростера, а сообщения копятся в очереди непрочитанными. "
    f"Разрешены: {', '.join(SLASH_ALLOWED)}."))
def slash(name: str, command: str) -> str:
    if not command.split()[0:1] or command.split()[0] not in SLASH_ALLOWED:
        return f"разрешены только: {', '.join(SLASH_ALLOWED)}"
    node = slave_node(name)
    if command.startswith("/model "):
        slaves.switch_model(node, name, command.split(None, 1)[1])
        return f"{name}: {command}"
    return f"{name}: {command}\n{slaves.type_command(node, name, command)[-1500:]}"


@master_tool(annotations=DESTRUCTIVE, description=(
    "Раздать на узлы пула креды claude.ai и ключи LLM-провайдеров. Лечит "
    "слейва, упёршиеся в протухший логин."))
def login() -> str:
    results, what, note = keys.push_login()
    out = [("везу: " + " + ".join(what))] + ([note] if note else [])
    return "\n".join(out + table([(n, results[n]) for n in sorted(results)]))


def watch_inbox():
    """Подписки мастера: свой инбокс и общий инбокс шарда.

    MCP умеет только «запрос-ответ» — вбросить что-то в ход модели сервер не
    может. Но он дочерний процесс сессии и знает её сокет, поэтому кладёт
    туда. Раньше на этом месте был поток, ждавший простоя внутри аллокации;
    теперь ждёт агент рядом с сокетом слейва, а сюда приезжает готовая весть.
    Этим же субъектом слейв отвечает мастеру — обратная сторона канала.

    Вторая подписка (`master.all.inbox`) — это весь механизм обнаружения:
    слейв спрашивает её глаголом `who` и узнаёт, кому он может ответить.
    Реестра мастеров нет и не нужно: мастер живёт ровно столько, сколько живёт
    его сессия, а любой реестр пережил бы её и врал.

    Молчим, если сессии нет: мастер, которому некуда положить весть, не имеет
    права называться живым адресом — слейв получит честное «нет на шине»
    вместо доставленного в никуда."""
    if not MASTER or not master_socket():
        return
    try:
        bus.subscribe(MY_INBOX, on_inbox)
        bus.subscribe(bus.inbox(bus.ALL_MASTERS), on_inbox)
    except bus.BusError:
        # Без шины сервер всё равно поднимется: доставка отобьётся понятной
        # ошибкой на первом же send, а молчащая подписка не соврёт успехом.
        pass


def main():
    # attach остаётся вне MCP: живой терминал инструментом не отдать.
    if "--check" in sys.argv:
        try:
            where = bus.config()["url"]
        except bus.BusError as e:
            where = f"НЕТ ({e})"
        who = ("узел" if not MASTER
               else "оператор" if bus.SHARD == bus.ADMIN
               else f"мастер шарда {bus.SHARD}")
        print(f"mop mcp: профиль {who}, "
              f"{len(app._tool_manager.list_tools())} инструментов, шина {where}, "
              f"адрес {my_name()}, инбокс {MY_INBOX if MASTER else '(не мастер)'}, "
              f"сессия: {master_socket() or 'не найдена'}")
        return 0
    watch_inbox()
    app.run("stdio")
    return 0


if __name__ == "__main__":
    sys.exit(main())
