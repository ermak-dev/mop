#!/usr/bin/env python3
"""запустить claude в режиме мастера шарда: mop master [--llm ПРОФИЛЬ] [git-origin]

Без аргумента берётся origin текущей рабочей копии. Один проект — один шард:
мастер видит и достаёт только своих слейвов, чужие для него не существуют.

Мастеров можно держать сколько угодно, в том числе несколько на один проект:
инбокс адресуется мастером, а не шардом, и вести не путаются.

Всё, что делает команда, — считает шард, находит его креды и уходит в claude.
Дальше срез наследуется: mop mcp, запущенный этой сессией как потомок, увидит
MOP_SHARD и MOP_BUS_CONFIG и подпишется на инбокс своего шарда.

Сервер пула приезжает АРГУМЕНТОМ, а не из конфига каталога. Мастер стоит в
рабочей копии СВОЕГО проекта, а `.mcp.json` с сервером лежит в репозитории
mop — то есть где угодно, только не там, где мастера запускают. Первый же
запуск в чужом каталоге поднял сессию вообще без mcp__mop__*, и она не смогла
ни увидеть ростер, ни написать слейву. Прописать сервер глобально можно, но
~/.claude.json — живое состояние, которое переписывают работающие сессии;
аргумент ничего не трогает и действует ровно на эту сессию.

Мастер поднимается в том же классе прав, что и пул, которым он командует.
Слейвы живут под --dangerously-skip-permissions, и канал сообщений сверяет
классы: отчёт слейва, приехавший в мастера обычного режима, кладётся в
held-очередь и ждёт человека — то есть петля перестаёт быть автоматической
ровно на главном своём сигнале. Цена названа: мастер держит токен Nomad,
пушит и ходит в трекер, и спрашивать он теперь не будет ни о чём.

--llm поднимает сессию мастера на профиле из mop/llm/ — том же наборе, каким
живут слейвы. Без флага действует MOP_DEFAULT_LLM установки. Статический env
профиля уходит в сессию целиком, а ключ читается из .env мастерской машины:
узельного secrets.env здесь нет, и местный .env для того и является
источником правды по ключам.
"""
import json
import os

import lib
from mop import config, llm, slaves

# --strict-mcp-config НЕ добавляем: у оператора есть свои серверы, и мастер-шелл
# не повод их отбирать.
def mcp_config():
    return json.dumps({"mcpServers": {"mop": {
        "type": "stdio",
        "command": os.path.join(os.path.dirname(os.path.realpath(__file__)), "mop"),
        "args": ["mcp"],
    }}})


def main(argv):
    profile, args = lib.parse_llm(argv)
    profile = profile or config.get("MOP_DEFAULT_LLM")
    if len(args) > 1:
        lib.usage(__doc__)
    origin = args[0] if args else lib.cwd_origin()
    shard = slaves.shard_of(origin)
    creds = lib.shard_creds(shard)
    if not os.path.exists(creds):
        # Курица и яйцо: у нового проекта ещё нет пользователя в конфиге NATS,
        # и слейв к шине не подключится. Говорим прямо, а не запускаем ansible
        # за спиной оператора: на узел ведёт одна дорога, и это deploy.
        lib.usage(f"нет кредов шарда {shard} ({creds}).\n"
                  f"Заведи шард: mop deploy nats")

    # Профиль тот же, что у слейвов, но источник ключа другой: не узловой
    # secrets.env (мастеру узел не выдавал ничего), а местный .env. Отказа — а
    # не тишины: сессия без ключа отбивает каждый ход 401-й, а читается живой.
    prof = llm.require(profile)
    env = dict(os.environ, MOP_SHARD=shard, MOP_BUS_CONFIG=creds,
               **prof["env"])
    if prof["key"]:
        key = config.get(prof["key"])
        if not key:
            lib.usage(f"профиль {profile}: нет {prof['key']} в "
                      f"{slaves.LOCAL_KEYS_FILE} — впиши и повтори")
        env[prof["auth_var"]] = key
    print(f"мастер шарда {shard} ({origin}) [{profile}]")
    os.execvpe("claude", ["claude", "--dangerously-skip-permissions",
                          "--mcp-config", mcp_config()] + args[1:], env)


lib.run(lib.cluster(main))
